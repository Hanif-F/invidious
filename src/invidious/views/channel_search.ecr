<%-
  ucid = channel.ucid
  author = HTML.escape(channel.author)
  channel_profile_pic = URI.parse(channel.author_thumbnail).request_target
  relative_url = "/channel/#{ucid}/search"
  youtube_url = "https://www.youtube.com/channel/#{ucid}"
  redirect_url = Invidious::Frontend::Misc.redirect_url(env)

  page_nav_html = IV::Frontend::Pagination.nav_numeric(locale,
    base_url: "#{relative_url}?#{URI::Params{ "q" => query.input }}",
    current_page: query.page,
    post: Invidious::Frontend::Desktop.private_search?(env),
    show_next: upstream_count >= 20,
  )
%>

<% content_for "header" do %>
<title><%= I18n.translate(locale, "search") %> - <%= author %> - Invidious</title>
<% end %>

<%= rendered "components/channel_info" %>

<%= rendered "components/items_paginated" %>

<% private_search = Invidious::Frontend::Desktop.private_search?(env); env.set "collection_kind", "add-items" %>
<% content_for "header" do %><title><%= I18n.translate(locale, "playlist_button_add_items") %> - <%= HTML.escape(playlist.title) %> - Invidious</title><% end %>
<header class="page-heading"><h1><%= I18n.translate(locale, "playlist_button_add_items") %></h1><p><a href="/playlist?list=<%= URI.encode_www_form(plid) %>" dir="auto"><%= HTML.escape(playlist.title) %></a></p></header>
<form class="collection-search" action="/add_playlist_items" method="<%= private_search ? "post" : "get" %>" role="search"><label for="playlist-item-search"><%= I18n.translate(locale, "Search for videos") %></label><div class="toolbar"><input type="search" id="playlist-item-search" name="q" value="<%= HTML.escape(query.input) %>" autocomplete="off"><button class="button button-primary"><%= Invidious::Frontend::Icons.render("search") %><%= I18n.translate(locale, "search") %></button></div><input type="hidden" name="list" value="<%= HTML.escape(plid) %>"><input type="hidden" name="region" value="<%= HTML.escape(query.region || "") %>"><% query.to_http_params.each do |key, value| %><% unless {"q", "list", "region", "page"}.includes?(key) %><input type="hidden" name="<%= HTML.escape(key) %>" value="<%= HTML.escape(value) %>"><% end %><% end %></form>
<% reset_params = query.to_http_params; reset_params["list"] = plid; reset_params["reset_member_videos"] = "1"; reset_params.delete_all("show_member_videos") %>
<%= Invidious::Frontend::SearchFilters.generate(query.filters, query.input, query.page, locale, false, false, Invidious::Frontend::MemberVideos.show?(env), "/add_playlist_items?#{reset_params}", private_search, query.region, "/add_playlist_items", {"list" => plid}, videos_only: true) %>
<% if env.get?("playlist_search_error") == true %><p class="status-panel" role="alert"><%= I18n.translate(locale, "overhaul_playlist_search_error") %></p><% end %>
<section data-collection data-collection-kind="add-items" data-fixed-playlist="<%= HTML.escape(plid) %>">
<% collection_kind = "add-items" %><%= rendered "overhaul/collection_toolbar" %>
<%= rendered "components/items_paginated" %></section>

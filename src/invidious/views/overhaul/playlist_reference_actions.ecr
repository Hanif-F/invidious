<% reference_user = env.get?("user").try &.as(User); reference_saved = env.get?("playlist_saved") == true %>
<% if reference_user %><% if reference_saved %><a class="button" href="/delete_playlist?list=<%= URI.encode_www_form(reference_id) %>"><%= Invidious::Frontend::Icons.render("bookmark") %><%= I18n.translate(locale, "overhaul_unsave_playlist") %></a><% else %><form action="/subscribe_playlist?list=<%= URI.encode_www_form(reference_id) %><%= "&continuation=#{URI.encode_www_form(reference_seed)}" if reference_seed %>" method="post"><input type="hidden" name="csrf_token" value="<%= HTML.escape(env.get?("csrf_token").try(&.as(String)) || "") %>"><button class="button"><%= Invidious::Frontend::Icons.render("bookmark") %><%= I18n.translate(locale, "overhaul_save_playlist") %></button></form><% end %>
<% elsif CONFIG.login_enabled %><a class="button" href="/login?referer=<%= URI.encode_www_form(env.request.resource) %>"><%= Invidious::Frontend::Icons.render("bookmark") %><%= I18n.translate(locale, "overhaul_save_playlist") %></a><% end %>

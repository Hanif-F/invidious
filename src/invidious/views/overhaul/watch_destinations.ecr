                <%-
                    link_yt_embed = URI.new(scheme: "https", host: "www.youtube.com", path: "/embed/#{video.id}")

                    if !plid.nil? && !continuation.nil?
                        link_yt_param = URI::Params{"list" => [plid], "index" => [continuation.to_s]}
                        link_yt_embed = IV::HttpServer::Utils.add_params_to_url(link_yt_embed, link_yt_param)
                    end
                -%>
                <% unless native_clip %><a id="link-yt-embed" referrerpolicy="origin-when-cross-origin" rel="noopener" data-base-url="<%= link_yt_embed %>" href="<%= link_yt_embed %>"><%= Invidious::Frontend::Icons.render("external-link") %><%= I18n.translate(locale, "videoinfo_youTube_embed_link") %></a><% end %>

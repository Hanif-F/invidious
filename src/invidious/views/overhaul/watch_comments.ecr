<section id="comments" class="comment-list watch-comments" aria-labelledby="comments-heading">
    <h2 id="comments-heading"><%= I18n.translate(locale, "ui_comments") %></h2>
    <% if (params.comments <=> ["", ""]) == 0 %>
        <p id="comments-disabled-message" class="muted"><%= HTML.escape(I18n.translate(locale, "comments_invidious_disabled_text")) %></p>
    <% else %>
        <div class="comment-toolbar js-only">
            <label for="comment-source"><%= I18n.translate(locale, "overhaul_comment_source") %><select id="comment-source"><option value="youtube"><%= I18n.translate(locale, "youtube") %></option></select></label>
            <label for="comment-sort"><%= I18n.translate(locale, "overhaul_comment_sort") %><select id="comment-sort"></select></label>
        </div>
        <p id="comment-source-link" class="comment-source-link"></p>
        <div id="comments-results"><% if nojs %><%= comment_html %><% else %><noscript><a class="button" href="<%= native_clip ? native_clip.permalink : "/watch" %>?<%= HTML.escape(env.params.query.to_s) %>&nojs=1"><%= I18n.translate(locale, "Hi! Looks like you have JavaScript turned off. Click here to view comments, keep in mind they may take a bit longer to load.") %></a></noscript><% end %></div>
        <script id="comment-threads-config" type="application/json"><%= {
            "target" => "comments-results", "heading" => "comments-heading", "headingText" => I18n.translate(locale, "ui_comments"), "watch" => true, "initial" => !nojs,
            "baseUrl" => "/api/v1/comments/#{video.id}", "locale" => locale, "thinMode" => preferences.thin_mode, "youtubeEnabled" => video.comments?, "initialSort" => env.params.query["comments_sort"]?,
            "disabledText" => I18n.translate(locale, "comments_youtube_disabled_text"), "empty" => I18n.translate(locale, "overhaul_comment_empty"), "unavailable" => I18n.translate(locale, "overhaul_comment_unavailable"),
            "hideReplies" => I18n.translate(locale, "Hide replies"), "showReplies" => I18n.translate(locale, "Show replies"), "countText" => I18n.translate(locale, "overhaul_comments_count", "{count}"),
            "youtubeSort" => [["top", I18n.translate(locale, "overhaul_comment_sort_top")], ["new", I18n.translate(locale, "overhaul_comment_sort_new")]]
        }.to_json.gsub("<", "\\u003c") %></script>
    <% end %>
</section>

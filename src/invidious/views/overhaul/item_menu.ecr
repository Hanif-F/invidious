<details class="ui-menu video-context" data-ui-menu data-video-id="<%= HTML.escape(item.id) %>" data-channel-id="<%= HTML.escape(channel_id) %>" data-channel-name="<%= HTML.escape(item.author) %>"><summary class="icon-button" aria-label="<%= I18n.translate(locale, "Video actions") %>" title="<%= I18n.translate(locale, "Video actions") %>"><%= Invidious::Frontend::Icons.render("ellipsis-vertical") %></summary><div class="menu-content video-context-actions">
<a href="<%= HTML.escape(item_url) %>"><%= Invidious::Frontend::Icons.render("play") %><%= I18n.translate(locale, "overhaul_play") %></a>
<% if env.get?("user") %>
<% if target_playlist = env.get?("add_playlist_items").try(&.as(String)) %><form data-collection-action="playlist" method="post" action="/playlist_ajax?action=add_video&video_id=<%= HTML.escape(item.id) %>&playlist_id=<%= URI.encode_www_form(target_playlist) %>&referer=<%= URI.encode_www_form("/playlist?list=#{target_playlist}") %>"><input type="hidden" name="csrf_token" value="<%= HTML.escape(env.get?("csrf_token").try(&.as(String)) || "") %>"><button type="submit"><%= Invidious::Frontend::Icons.render("plus") %><%= I18n.translate(locale, "Add to playlist") %></button></form><% else %><a href="/feed/playlists?video_id=<%= HTML.escape(item.id) %>" data-video-action="playlist"><%= Invidious::Frontend::Icons.render("bookmark") %><%= I18n.translate(locale, "Add to playlist") %></a><% end %>
<% if env.get?("collection_kind") && !env.get?("add_playlist_items") && env.get?("user").try(&.as(User).preferences.watch_history) %><% marked = !!env.get?("user").try(&.as(User).watched.includes?(item.id)); mark_action = marked ? "unwatched" : "watched" %><form data-collection-action="<%= mark_action %>" method="post" action="/watch_ajax?action=mark_<%= mark_action %>&id=<%= HTML.escape(item.id) %>&referer=<%= URI.encode_www_form(env.request.resource) %>"><input type="hidden" name="csrf_token" value="<%= HTML.escape(env.get?("csrf_token").try(&.as(String)) || "") %>"><button type="submit"><%= Invidious::Frontend::Icons.render("check") %><%= I18n.translate(locale, "ux_#{mark_action}") %></button></form><% end %>
<% if item.is_a?(PlaylistVideo) && (owned_playlist = env.get?("remove_playlist_items").try(&.as(String))) %><form data-collection-action="remove" method="post" action="/playlist_ajax?action=remove_video&set_video_id=<%= item.index %>&playlist_id=<%= URI.encode_www_form(owned_playlist) %>&referer=<%= URI.encode_www_form(env.request.resource) %>"><input type="hidden" name="csrf_token" value="<%= HTML.escape(env.get?("csrf_token").try(&.as(String)) || "") %>"><button type="submit"><%= Invidious::Frontend::Icons.render("trash-2") %><%= I18n.translate(locale, "ux_remove") %></button></form><% end %>
<% unless channel_id.empty? %><% channel_blocked = Invidious::Frontend::BlockedChannels.ids(env).includes?(channel_id) %><button type="button" data-video-action="<%= channel_blocked ? "unblock" : "block" %>"><%= Invidious::Frontend::Icons.render("shield") %><span data-action-label><%= I18n.translate(locale, channel_blocked ? "Unblock channel" : "Block channel") %></span></button><% end %>
<% elsif CONFIG.login_enabled %><a href="/login?referer=<%= URI.encode_www_form(env.request.resource) %>"><%= Invidious::Frontend::Icons.render("bookmark") %><%= I18n.translate(locale, "Add to playlist") %></a><% unless channel_id.empty? %><a href="/login?referer=<%= URI.encode_www_form(env.request.resource) %>"><%= Invidious::Frontend::Icons.render("shield") %><%= I18n.translate(locale, "Block channel") %></a><% end %><% end %>
<% unless channel_id.empty? %>
<a href="/channel/<%= HTML.escape(channel_id) %>"><%= Invidious::Frontend::Icons.render("user") %><%= I18n.translate(locale, "overhaul_view_channel") %></a>
<a href="/preferences/spoilers/channels?channel=<%= URI.encode_www_form(channel_id) %>"><%= Invidious::Frontend::Icons.render("eye-off") %><%= I18n.translate(locale, "spoilers_settings") %></a>
<% end %>
<hr><a href="/watch<%= HTML.escape(endpoint_params) %>&listen=1"><%= Invidious::Frontend::Icons.render("headphones") %><%= I18n.translate(locale, "Audio mode") %></a>
<a href="https://www.youtube.com/watch<%= HTML.escape(endpoint_params) %>" rel="noreferrer noopener"><%= Invidious::Frontend::Icons.render("external-link") %><%= I18n.translate(locale, "videoinfo_watch_on_youTube") %></a>
<a href="<%= HTML.escape(env.get("preferences").as(Preferences).automatic_instance_redirect ? "/redirect?referer=#{URI.encode_www_form("/watch#{endpoint_params}")}" : "https://redirect.invidious.io/watch#{endpoint_params}") %>"><%= Invidious::Frontend::Icons.render("external-link") %><%= I18n.translate(locale, "Switch Invidious Instance") %></a>
</div></details>

<% video_id = entry.video_id; channel_id = entry.channel_id || ""; item_date = Invidious::ChannelSpoilers.publication(entry.release_date); item_url = "/watch?v=#{URI.encode_www_form(video_id)}" %>
<article class="media-item media-row" data-kind="video" data-video-id="<%= HTML.escape(video_id) %>" data-channel-id="<%= HTML.escape(channel_id) %>"><%= rendered "overhaul/selection" %>
<div class="thumbnail video-thumbnail"><a href="<%= item_url %>" tabindex="-1"><% image = if ai_kind = Invidious::Frontend::AiChannels.thumbnail_kind(env, channel_id)
 Invidious::Frontend::AiChannels.render_thumbnail(ai_kind, locale)
 else
 %(<img src="/vi/#{HTML.escape(video_id)}/mqdefault.jpg" width="320" height="180" alt="" loading="lazy">)
 end %><%= Invidious::Frontend::ChannelSpoilers.thumbnail(env, video_id, channel_id, item_date, image) %></a><%= Invidious::Frontend::WatchedIndicator.render(video_id, entry.length_seconds, true) %><% if length = entry.length_seconds %><span class="duration"><%= recode_length_seconds(length) %></span><% end %></div>
<div class="media-details"><h3 class="media-title" data-dearrow-row><a href="<%= item_url %>" dir="auto"><%= Invidious::Frontend::ChannelSpoilers.title(env, video_id, channel_id, entry.title || "#{I18n.translate(locale, "ui_open_video")} (#{video_id})", item_date) %></a></h3>
<% unless channel_id.empty? %><a class="channel-attribution" href="/channel/<%= URI.encode_www_form(channel_id) %>"><%= Invidious::Frontend::ChannelAvatars.render(env, channel_id, 24, name: entry.channel_name) %><span dir="auto"><%= HTML.escape(entry.channel_name || channel_id) %></span></a><% else %><p class="muted" dir="auto"><%= HTML.escape(entry.channel_name || I18n.translate(locale, "history_channel_unknown")) %></p><% end %>
<div class="media-meta"><span><%= I18n.translate(locale, "history_released") %>: <%= HTML.escape(entry.release_date || I18n.translate(locale, "history_date_unknown")) %></span><span><%= I18n.translate(locale, "history_watched") %>: <%= HTML.escape(entry.latest_watched || I18n.translate(locale, "history_watch_date_unknown")) %></span><% if count = Invidious::Frontend::ViewCounts.get(env, video_id) %><span><%= HTML.escape(count.text(locale)) %></span><% end %></div></div>
<details class="ui-menu video-context" data-ui-menu data-video-id="<%= HTML.escape(video_id) %>" data-channel-id="<%= HTML.escape(channel_id) %>" data-channel-name="<%= HTML.escape(entry.channel_name || channel_id) %>"><summary class="icon-button" aria-label="<%= I18n.translate(locale, "Video actions") %>"><%= Invidious::Frontend::Icons.render("ellipsis-vertical") %></summary><div class="menu-content video-context-actions"><a href="<%= item_url %>"><%= Invidious::Frontend::Icons.render("play") %><%= I18n.translate(locale, "overhaul_play") %></a><a href="/feed/playlists?video_id=<%= URI.encode_www_form(video_id) %>" data-video-action="playlist"><%= Invidious::Frontend::Icons.render("bookmark") %><%= I18n.translate(locale, "Add to playlist") %></a>
<form action="/watch_ajax?action=mark_unwatched&id=<%= URI.encode_www_form(video_id) %>&referer=<%= URI.encode_www_form(env.request.resource) %>" method="post" data-collection-action="remove"><input type="hidden" name="csrf_token" value="<%= HTML.escape(env.get?("csrf_token").try(&.as(String)) || "") %>"><button type="submit" <%= "disabled" unless env.get("user").as(User).preferences.watch_history %>><%= Invidious::Frontend::Icons.render("trash-2") %><%= I18n.translate(locale, "ui_remove_history") %></button></form>
<% unless channel_id.empty? %><a href="/preferences/spoilers/channels?channel=<%= URI.encode_www_form(channel_id) %>"><%= Invidious::Frontend::Icons.render("eye-off") %><%= I18n.translate(locale, "spoilers_settings") %></a><% end %>
<a href="<%= item_url %>&listen=1"><%= Invidious::Frontend::Icons.render("headphones") %><%= I18n.translate(locale, "Audio mode") %></a><a href="https://www.youtube.com/watch?v=<%= URI.encode_www_form(video_id) %>" rel="noreferrer noopener"><%= Invidious::Frontend::Icons.render("external-link") %><%= I18n.translate(locale, "videoinfo_watch_on_youTube") %></a></div></details>
</article>

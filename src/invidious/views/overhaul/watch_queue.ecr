        <section class="watch-tool queue-panel" id="playlist-panel" aria-labelledby="queue-heading">
            <header class="queue-heading">
                <h2 id="queue-heading"><%= I18n.translate(locale, "overhaul_queue") %></h2>
                <a id="queue-title" href="/<%= plid.starts_with?("RD") ? "mix" : "playlist" %>?list=<%= plid %>"><%= I18n.translate(locale, "ui_open_playlist") %></a>
                <p class="queue-context"><span id="queue-count"></span><span id="queue-current" data-dearrow-row><%= I18n.translate(locale, "ui_now_playing") %>: <%= Invidious::Frontend::ChannelSpoilers.title(env, video.id, video.ucid, original_title, spoiler_date, custom: !!native_clip) %></span></p>
            </header>
            <div id="queue-navigation" class="queue-navigation" hidden></div>
            <p id="queue-status" class="queue-status" role="status"></p>
            <button id="queue-retry" class="button queue-retry" type="button" hidden><%= I18n.translate(locale, "ui_retry") %></button>
            <div id="playlist" class="queue-list" role="region" aria-labelledby="queue-heading" tabindex="0" hidden></div>
        </section>

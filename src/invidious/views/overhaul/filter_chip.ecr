<% if search_privacy %><form action="/search" method="post" class="filter-chip"><% chip_params.each do |name, value| %><input type="hidden" name="<%= HTML.escape(name) %>" value="<%= HTML.escape(value) %>"><% end %><button class="button" type="submit" aria-label="<%= HTML.escape(I18n.translate(locale, "ui_remove_filter") + ": " + chip_label) %>"><%= HTML.escape(chip_label) %><%= Invidious::Frontend::Icons.render("x") %></button></form><% else %><a class="filter-chip" href="/search?<%= HTML.escape(chip_params.to_s) %>" aria-label="<%= HTML.escape(I18n.translate(locale, "ui_remove_filter") + ": " + chip_label) %>"><%= HTML.escape(chip_label) %><%= Invidious::Frontend::Icons.render("x") %></a><% end %>

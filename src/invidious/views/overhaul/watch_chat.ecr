<section class="chat-panel" id="chat-panel" <%= "hidden" if initial_tool != "chat" %> aria-labelledby="chat-heading">
    <header class="chat-heading"><h2 id="chat-heading"><%= I18n.translate(locale, "ui_chat_replay") %></h2><button type="button" class="icon-button js-only" data-open-dialog="chat-settings-dialog" aria-haspopup="dialog" aria-controls="chat-settings-dialog" aria-label="<%= I18n.translate(locale, "ui_chat_settings") %>" title="<%= I18n.translate(locale, "ui_chat_settings") %>"><%= Invidious::Frontend::Icons.render("settings") %></button></header>
    <div class="chat-scroll-area js-only"><div class="chat-messages" id="chat-messages" role="log" tabindex="0" aria-live="off" aria-label="<%= I18n.translate(locale, "overhaul_chat_messages") %>"></div><button id="chat-sync" class="chat-sync button" type="button" aria-controls="chat-messages" hidden><%= I18n.translate(locale, "ui_sync_chat") %></button></div>
    <div class="chat-footer js-only"><p id="chat-status" role="status"><%= I18n.translate(locale, "ui_chat_loading") %></p><button id="chat-retry" class="button" type="button" hidden><%= Invidious::Frontend::Icons.render("rotate-cw") %><%= I18n.translate(locale, "ui_retry") %></button></div>
</section>
<dialog id="chat-settings-dialog" class="chat-settings-dialog" aria-labelledby="chat-dialog-heading"><header class="dialog-heading"><h2 id="chat-dialog-heading"><%= I18n.translate(locale, "ui_chat_settings") %></h2><form method="dialog"><button type="submit" class="icon-button" aria-label="<%= I18n.translate(locale, "Close") %>"><%= Invidious::Frontend::Icons.render("x") %></button></form></header>
    <div class="chat-settings-content"><%= rendered "overhaul/chat_preferences" %>
    <section class="chat-video-timing" aria-labelledby="chat-timing-heading"><h3 id="chat-timing-heading"><%= I18n.translate(locale, "overhaul_chat_video_timing") %></h3>
        <form id="chat-timing-form"><label for="chat-timing"><%= I18n.translate(locale, "ui_chat_custom_timing") %></label><input id="chat-timing" name="timing" type="number" required min="-3600" max="3600" step="0.001" value="0" disabled><p class="muted"><%= I18n.translate(locale, "overhaul_chat_timing_help") %></p>
        <div class="settings-actions"><button type="submit" class="button button-primary" disabled><%= I18n.translate(locale, "overhaul_chat_save_timing") %></button><button type="reset" class="button" hidden><%= I18n.translate(locale, "ux_discard") %></button><button type="button" class="button" data-timing-readback hidden><%= I18n.translate(locale, "overhaul_check_saved") %></button><span role="status"></span></div></form>
    </section>
    <p><a class="button" href="/preferences?section=chat"><%= Invidious::Frontend::Icons.render("settings") %><%= I18n.translate(locale, "overhaul_chat_all_settings") %></a></p></div>
</dialog>
<script id="chat-timing-config" type="application/json"><%= {account: !!user, videoId: video.id, offsetMs: chat_timing_ms, words: {saved: I18n.translate(locale, "settings_saved"), unsaved: I18n.translate(locale, "settings_unsaved"), saving: I18n.translate(locale, "settings_saving"), error: I18n.translate(locale, "settings_save_error"), unconfirmed: I18n.translate(locale, "settings_save_unconfirmed"), page_only: I18n.translate(locale, "settings_page_only")}}.to_json.gsub("<", "\\u003c") %></script>

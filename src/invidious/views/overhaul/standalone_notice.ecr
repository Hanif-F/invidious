<% notice_preferences = env.get?("preferences").try(&.as(Preferences)) || Preferences.from_json("{}"); locale = notice_preferences.locale %>
<!doctype html><html lang="<%= HTML.escape(locale) %>" dir="<%= I18n.locale_is_rtl?(locale) ? "rtl" : "ltr" %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= HTML.escape(I18n.translate(locale, heading)) %> - Invidious</title><link rel="stylesheet" href="/css/foundation.css?v=<%= ASSET_COMMIT %>"><link rel="stylesheet" href="/css/verification.css?v=<%= ASSET_COMMIT %>"></head>
<body class="<%= notice_preferences.dark_mode == "dark" ? "dark" : notice_preferences.dark_mode == "light" ? "light" : "no" %>-theme"><main class="verification-panel" id="main-content"><header><span class="brand">Invidious</span><h1 dir="auto"><%= HTML.escape(I18n.translate(locale, heading)) %></h1></header><p dir="auto"><%= HTML.escape(I18n.translate(locale, message)) %></p>
<div class="toolbar">
<% notice_csrf = env.get?("csrf_token").try(&.as(String)) || "" %>
<% if sign_out && env.get?("user") && !notice_csrf.empty? %><form method="post" action="/signout?referer=<%= HTML.escape(URI.encode_www_form(destination)) %>"><input type="hidden" name="csrf_token" value="<%= HTML.escape(notice_csrf) %>"><button class="button" type="submit"><%= I18n.translate(locale, "Log out") %></button></form><% else %><a class="button button-primary" href="<%= HTML.escape(destination) %>"<% if new_window %> target="_blank" rel="noopener noreferrer"<% end %>><%= HTML.escape(I18n.translate(locale, action)) %></a><% end %>
</div></main></body></html>

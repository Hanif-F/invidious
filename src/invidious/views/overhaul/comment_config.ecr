<script id="comment-threads-config" type="application/json"><%= {"target" => "comments", "heading" => "comments-heading", "initial" => comment_initial, "headingText" => I18n.translate(locale, "ui_comments"), "empty" => I18n.translate(locale, "overhaul_comment_empty"), "unavailable" => I18n.translate(locale, "overhaul_comment_unavailable"), "thinMode" => env.get("preferences").as(Preferences).thin_mode, "baseUrl" => comment_base_url, "ucid" => comment_ucid, "locale" => locale, "hideReplies" => I18n.translate(locale, "Hide replies"), "showReplies" => I18n.translate(locale, "Show replies"), "countText" => I18n.translate(locale, "overhaul_comments_count", "{count}")}.to_json.gsub("<", "\\u003c") %></script>
<script src="/js/comment-threads.js?v=<%= ASSET_COMMIT %>" defer></script>

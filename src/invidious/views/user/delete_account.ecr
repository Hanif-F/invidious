<% content_for "header" do %><title><%= I18n.translate(locale, "Delete account") %> - Invidious</title><% end %>
<section class="reading-page account-page" aria-labelledby="delete-heading">
  <h1 id="delete-heading"><%= I18n.translate(locale, "Delete account?") %></h1>
  <% if error %><p class="form-feedback" role="alert"><%= HTML.escape(I18n.translate(locale, error)) %></p><% end %>
  <p><%= I18n.translate(locale, "ux_delete_consequences") %></p>
  <p class="muted"><%= I18n.translate(locale, "ux_delete_backup") %></p>
  <nav class="toolbar"><a class="button" href="/data_control"><%= I18n.translate(locale, "Import and Export Data") %></a></nav>
  <form class="stacked-form account-form account-section" action="/delete_account?referer=<%= HTML.escape(URI.encode_www_form(referer)) %>" method="post" data-account-form>
    <input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>">
    <label for="password"><%= I18n.translate(locale, "Current password") %></label>
    <input id="password" name="password" type="password" autocomplete="current-password" required>
    <div class="toolbar">
      <a class="button" href="<%= HTML.escape(referer) %>" <%= "autofocus" unless error %>><%= I18n.translate(locale, "Cancel") %></a>
      <button type="submit" name="submit" value="delete_account" class="button button-danger"><%= I18n.translate(locale, "Delete account") %></button>
    </div>
  </form>
</section>

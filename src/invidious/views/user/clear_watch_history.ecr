<% content_for "header" do %><title><%= I18n.translate(locale, "Clear watch history") %> - Invidious</title><% end %>
<section class="reading-page"><h1><%= I18n.translate(locale, "Clear watch history?") %></h1><p><%= I18n.translate(locale, "Clearing watch history also removes all saved playback positions.") %></p><form action="/clear_watch_history?referer=<%= URI.encode_www_form(referer) %>" method="post"><input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>"><div class="toolbar"><button class="button button-danger" type="submit" name="submit" value="clear_watch_history"><%= Invidious::Frontend::Icons.render("trash-2") %><%= I18n.translate(locale, "Clear watch history") %></button><a class="button" href="<%= HTML.escape(referer) %>"><%= I18n.translate(locale, "generic_button_cancel") %></a></div></form></section>

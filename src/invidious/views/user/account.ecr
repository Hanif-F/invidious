<% content_for "header" do %><title><%= I18n.translate(locale, "Account settings") %> - Invidious</title><% end %>
<section class="reading-page account-page" aria-labelledby="account-heading">
  <header class="page-heading"><h1 id="account-heading"><%= I18n.translate(locale, "Account settings") %></h1></header>
  <% if error %><p class="form-feedback" role="alert"><%= HTML.escape(I18n.translate(locale, error)) %></p><% end %>
  <% if !error && env.params.query["updated"]? == "true" %><p class="form-feedback" role="status"><%= I18n.translate(locale, "Account updated. Other sessions and API tokens have been revoked.") %></p><% end %>
  <p class="muted"><%= I18n.translate(locale, "Changing your username or password signs out other sessions and revokes API tokens.") %></p>
  <section class="account-section" aria-labelledby="rename-heading">
    <h2 id="rename-heading"><%= I18n.translate(locale, "Change username") %></h2>
    <form class="stacked-form account-form" action="/account/username" method="post" data-account-form>
      <input type="hidden" name="csrf_token" value="<%= HTML.escape(username_token) %>">
      <label for="username"><%= I18n.translate(locale, "Username") %></label>
      <input id="username" name="username" value="<%= HTML.escape(username) %>" autocomplete="username" autocapitalize="none" spellcheck="false" required minlength="3" maxlength="32" pattern="[a-zA-Z0-9_.\-]{3,32}" aria-describedby="username-help">
      <p id="username-help" class="muted"><%= I18n.translate(locale, "Use 3–32 letters, numbers, underscores, dots, or hyphens.") %></p>
      <label for="rename-password"><%= I18n.translate(locale, "Current password") %></label>
      <input id="rename-password" name="password" type="password" autocomplete="current-password" required>
      <div class="toolbar"><button class="button button-primary" type="submit"><%= I18n.translate(locale, "Change username") %></button></div>
    </form>
  </section>
  <section class="account-section" aria-labelledby="password-heading">
    <h2 id="password-heading"><%= I18n.translate(locale, "Change password") %></h2>
    <form class="stacked-form account-form" action="/change_password" method="post" data-account-form>
      <input type="hidden" name="csrf_token" value="<%= HTML.escape(password_token) %>">
      <input type="hidden" name="username" autocomplete="username" value="<%= HTML.escape(user.username) %>">
      <label for="current-password"><%= I18n.translate(locale, "Current password") %></label>
      <input id="current-password" name="password" type="password" autocomplete="current-password" required>
      <label for="new-password"><%= I18n.translate(locale, "New password") %></label>
      <input id="new-password" name="new_password[0]" type="password" autocomplete="new-password" aria-describedby="password-help" required>
      <p id="password-help" class="muted"><%= I18n.translate(locale, "Use at least 15 characters and at most 72 UTF-8 bytes.") %></p>
      <label for="confirm-password"><%= I18n.translate(locale, "Confirm password") %></label>
      <input id="confirm-password" name="new_password[1]" type="password" autocomplete="new-password" required>
      <div class="toolbar"><button class="button button-primary" type="submit"><%= I18n.translate(locale, "Change password") %></button></div>
    </form>
  </section>
  <section class="account-section" aria-labelledby="account-tools-heading">
    <h2 id="account-tools-heading"><%= I18n.translate(locale, "ux_account_tools") %></h2>
    <nav class="toolbar" aria-label="<%= I18n.translate(locale, "ux_account_tools") %>">
      <a class="button" href="/token_manager"><%= Invidious::Frontend::Icons.render("shield") %><%= I18n.translate(locale, "overhaul_sessions") %></a>
      <a class="button" href="/data_control"><%= Invidious::Frontend::Icons.render("download") %><%= I18n.translate(locale, "Import and Export Data") %></a>
      <a class="button" href="/tv"><%= Invidious::Frontend::Icons.render("monitor") %><%= I18n.translate(locale, "ux_tv_heading") %></a>
    </nav>
  </section>
  <section class="account-section" aria-labelledby="delete-heading">
    <h2 id="delete-heading"><%= I18n.translate(locale, "Delete account") %></h2>
    <p class="muted"><%= I18n.translate(locale, "ux_delete_summary") %></p>
    <a class="button button-danger" href="/delete_account?referer=%2Faccount"><%= I18n.translate(locale, "ux_delete_review") %></a>
  </section>
</section>

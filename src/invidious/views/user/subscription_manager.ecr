<% content_for "header" do %><title><%= I18n.translate(locale, "Subscription manager") %> - Invidious</title><% end %>
<header class="page-heading"><h1><%= I18n.translate(locale, "Subscription manager") %></h1><p><%= I18n.translate(locale, "Subscriptions") %>: <span id="count"><%= subscriptions.size %></span></p></header>
<div class="toolbar"><a class="button" href="/feed/subscriptions"><%= Invidious::Frontend::Icons.render("arrow-left") %><%= I18n.translate(locale, "Subscriptions") %></a><a class="button" href="/data_control"><%= Invidious::Frontend::Icons.render("download") %><%= I18n.translate(locale, "Import/export") %></a></div>
<form class="toolbar collection-filters" action="/subscription_manager" method="get"><label for="subscription-sort"><%= I18n.translate(locale, "subscription_manager_sort_label") %></label><select id="subscription-sort" name="sort_by" aria-describedby="subscription-sort-help"><% Invidious::Frontend::SubscriptionManager::SORTS.each do |option| %><option value="<%= option %>" <%= "selected" if sort_by == option %>><%= I18n.translate(locale, "subscription_manager_sort_#{option}") %></option><% end %></select><button class="button"><%= I18n.translate(locale, "subscription_manager_sort_apply") %></button></form>
<p id="subscription-sort-help" class="muted"><%= I18n.translate(locale, "subscription_manager_sort_help") %></p>
<% Invidious::Frontend::ChannelAvatars.prepare_ids(env, subscriptions.map(&.id)) %>
<% collection_kind = "manager" %><section data-collection data-collection-kind="manager"><%= rendered "overhaul/collection_toolbar" %>
<% if subscriptions.empty? %><p class="status-panel"><%= I18n.translate(locale, "overhaul_no_subscriptions") %></p><% end %>
<div class="management-rows"><% subscriptions.each do |channel| %><% stats = subscription_stats[channel.id] %>
<article class="subscription-row<%= " deleted" if channel.deleted %>" data-channel-id="<%= HTML.escape(channel.id) %>"><%= rendered "overhaul/selection" %>
<a class="channel-attribution" href="/channel/<%= HTML.escape(channel.id) %>"><%= Invidious::Frontend::ChannelAvatars.render(env, channel.id, 40, name: channel.author) %><span dir="auto"><%= HTML.escape(channel.author) %></span></a>
<div class="subscription-statistics"><p><% if uploaded = stats.latest_upload %><%= I18n.translate(locale, "subscription_manager_last_upload", recode_date(uploaded, locale)) %><% else %><%= I18n.translate(locale, "subscription_manager_upload_unknown") %><% end %></p><p><%= I18n.translate_count(locale, sort_by == "most_watched" ? "subscription_manager_watched_total" : "subscription_manager_watched_recent", sort_by == "most_watched" ? stats.all_time_watched : stats.recent_watched) %></p></div>
<form action="/subscription_ajax?action=remove_subscriptions&c=<%= URI.encode_www_form(channel.id) %>&referer=/subscription_manager" method="post" data-collection-action="unsubscribe"><input type="hidden" name="csrf_token" value="<%= HTML.escape(env.get?("csrf_token").try(&.as(String)) || "") %>"><button class="button" type="submit"><%= I18n.translate(locale, "Unsubscribe") %></button></form>
</article><% end %></div></section>

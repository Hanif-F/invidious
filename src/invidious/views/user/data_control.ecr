<% content_for "header" do %><title><%= I18n.translate(locale, "Import and Export Data") %> - Invidious</title><% end %>
<section class="reading-page account-page" aria-labelledby="data-heading">
  <header class="page-heading"><h1 id="data-heading"><%= I18n.translate(locale, "Import and Export Data") %></h1><a class="button" href="/account"><%= I18n.translate(locale, "Account settings") %></a></header>
  <% if error %><p class="form-feedback" role="alert"><%= HTML.escape(I18n.translate(locale, error)) %> <%= I18n.translate(locale, "ux_data_choose_again") %></p><% end %>
  <section class="account-section" aria-labelledby="import-heading">
    <h2 id="import-heading"><%= I18n.translate(locale, "Import") %></h2>
    <p><%= I18n.translate(locale, "ux_data_partial") %></p>
    <p class="muted"><%= I18n.translate(locale, "ux_data_import_wait") %></p>
    <form class="stacked-form account-form" action="/data_control" method="get">
      <label for="import-source"><%= I18n.translate(locale, "ux_data_source") %></label>
      <select id="import-source" name="source"><% Invidious::Frontend::DataControl::SOURCES.each do |id, option| %><option value="<%= id %>" <%= source == id ? "selected" : "" %>><%= I18n.translate(locale, option[:label]) %></option><% end %></select>
      <input type="hidden" name="referer" value="<%= HTML.escape(referer) %>">
      <div class="toolbar"><button class="button" type="submit"><%= I18n.translate(locale, "ux_data_choose_source") %></button></div>
    </form>
    <% selected_source = Invidious::Frontend::DataControl::SOURCES[source] %>
    <form class="stacked-form account-form import-upload" enctype="multipart/form-data" action="/data_control?source=<%= source %>&amp;referer=<%= HTML.escape(URI.encode_www_form(referer)) %>" method="post" data-account-form>
      <input type="hidden" name="csrf_token" value="<%= HTML.escape(env.get?("csrf_token").try(&.as(String)) || "") %>">
      <label for="import-file"><%= I18n.translate(locale, selected_source[:label]) %></label>
      <p id="import-help" class="muted"><%= I18n.translate(locale, selected_source[:help]) %></p>
      <input type="file" id="import-file" name="<%= selected_source[:field] %>" accept="<%= selected_source[:accept] %>" aria-describedby="import-help import-after" required>
      <p id="import-after" class="muted"><%= I18n.translate(locale, "ux_data_check_after") %></p>
      <div class="toolbar"><button type="submit" class="button button-primary"><%= I18n.translate(locale, "Import") %></button></div>
    </form>
    <% if source.starts_with?("youtube") %><p class="data-format-help"><a href="https://github.com/iv-org/documentation/blob/master/docs/export-youtube-subscriptions.md" target="_blank" rel="noopener noreferrer"><%= I18n.translate(locale, "ux_data_youtube_help") %></a></p><% end %>
  </section>
  <section class="account-section" aria-labelledby="export-heading">
    <h2 id="export-heading"><%= I18n.translate(locale, "Export") %></h2>
    <p class="muted"><%= I18n.translate(locale, "ux_data_export_private") %></p>
    <div class="data-export-group"><h3><%= I18n.translate(locale, "ux_data_account_export") %></h3><p><%= I18n.translate(locale, "ux_data_json_scope") %></p><a class="button" href="/subscription_manager?action_takeout=1&amp;format=json"><%= Invidious::Frontend::Icons.render("download") %><%= I18n.translate(locale, "Export data as JSON") %></a></div>
    <div class="data-export-group"><h3><%= I18n.translate(locale, "Subscriptions") %></h3><p><%= I18n.translate(locale, "ux_data_opml_scope") %></p><nav class="toolbar"><a class="button" href="/subscription_manager?action_takeout=1"><%= Invidious::Frontend::Icons.render("download") %><%= I18n.translate(locale, "Export subscriptions as OPML") %></a><a class="button" href="/subscription_manager?action_takeout=1&amp;format=opml"><%= Invidious::Frontend::Icons.render("download") %><%= I18n.translate(locale, "Export subscriptions as OPML (for FreeTube)") %></a><a class="button" href="/subscription_manager?action_takeout=1&amp;format=newpipe_json"><%= Invidious::Frontend::Icons.render("download") %><%= I18n.translate(locale, "Export subscriptions as JSON (for NewPipe)") %></a></nav></div>
    <p class="muted"><%= I18n.translate(locale, "ux_data_export_exclusions") %></p>
  </section>
</section>

<% content_for "header" do %><title><%= I18n.translate(locale, "History") %> - Invidious</title><% end %>
<header class="page-heading"><h1><%= I18n.translate(locale, "Watch history") %></h1><p><%= I18n.translate(locale, "channel_tab_videos_label") %>: <span id="count"><%= history_count %></span></p></header>
<div class="toolbar collection-heading-actions"><a class="button" href="/preferences?section=library"><%= Invidious::Frontend::Icons.render("settings") %><%= I18n.translate(locale, "overhaul_library_settings") %></a><a class="button button-danger" href="/clear_watch_history?referer=<%= URI.encode_www_form(env.request.resource) %>"><%= Invidious::Frontend::Icons.render("trash-2") %><%= I18n.translate(locale, "Clear watch history") %></a></div>
<% unless user.preferences.watch_history %><p class="status-panel"><%= I18n.translate(locale, "overhaul_history_paused") %></p><% end %>
<form class="scoped-search collection-filters" action="/feed/history" method="get" role="search"><label for="history-search"><%= I18n.translate(locale, "history_search") %></label><div><input type="search" id="history-search" name="q" value="<%= HTML.escape(history_query) %>" placeholder="<%= I18n.translate(locale, "history_search_placeholder") %>"><% if env.params.query.has_key?("max_results") %><input type="hidden" name="max_results" value="<%= max_results %>"><% end %><button class="icon-button" aria-label="<%= I18n.translate(locale, "Search") %>"><%= Invidious::Frontend::Icons.render("search") %></button><% unless history_query.empty? %><a class="button" href="<%= HTML.escape(history_clear_url) %>"><%= I18n.translate(locale, "history_clear_search") %></a><% end %></div></form>
<% Invidious::Frontend::ChannelAvatars.prepare_ids(env, watched.compact_map(&.channel_id)); Invidious::Frontend::ViewCounts.prepare(env, watched); Invidious::Frontend::AiChannels.prepare_ids(env, watched.compact_map(&.channel_id)); Invidious::Frontend::ChannelSpoilers.prepare(env, watched) %>
<% collection_kind = "history" %><section data-collection data-collection-kind="history"><%= rendered "overhaul/collection_toolbar" %>
<% if watched.empty? %><p class="status-panel"><%= I18n.translate(locale, history_query.empty? ? "history_empty" : "history_no_matches") %></p><% end %>
<% previous_group = "" %><div class="history-groups" data-browse-items>
<% watched.each do |entry| %><% group = Invidious::History.group(entry.latest_watched, history_today) %><% if group != previous_group %><% unless previous_group.empty? %></div></section><% end %><section class="history-group" data-history-group="<%= HTML.escape(group) %>"><h2><%= I18n.translate(locale, group) %></h2><div class="media-rows"><% previous_group = group %><% end %><%= rendered "overhaul/history_item" %><% end %><% unless previous_group.empty? %></div></section><% end %></div>
<%= Invidious::Frontend::Pagination.nav_numeric(locale, base_url: base_url, current_page: page, show_next: max_results > 0 && page.to_i64 * max_results < history_count) %><%= rendered "components/browse_controls" %>
</section>

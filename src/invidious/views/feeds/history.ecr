<% content_for "header" do %>
<title><%= I18n.translate(locale, "History") %> - Invidious</title>
<% end %>

<h1><%= I18n.translate(locale, "Watch history") %></h1>
<div class="pure-g h-box">
    <div class="pure-u-1-3">
        <h3><%= I18n.translate_count(locale, "generic_videos_count", history_count, I18n::NumberFormatting::HtmlSpan) %></h3>
    </div>
    <div class="pure-u-1-3">
        <h3 style="text-align:center">
            <a href="/feed/subscriptions"><%= I18n.translate_count(locale, "generic_subscriptions_count", user.subscriptions.size, I18n::NumberFormatting::HtmlSpan) %></a>
        </h3>
    </div>
    <div class="pure-u-1-3">
        <h3 style="text-align:right">
            <a href="/clear_watch_history"><%= I18n.translate(locale, "Clear watch history") %></a>
        </h3>
    </div>
</div>

<form class="pure-form h-box" action="/feed/history" method="get" role="search" aria-label="<%= I18n.translate(locale, "history_search") %>">
    <label for="history-search"><%= I18n.translate(locale, "history_search") %></label>
    <input type="search" id="history-search" name="q" value="<%= HTML.escape(history_query) %>" placeholder="<%= I18n.translate(locale, "history_search_placeholder") %>">
    <% if env.params.query.has_key?("max_results") %>
    <input type="hidden" name="max_results" value="<%= max_results %>">
    <% end %>
    <button type="submit" class="pure-button pure-button-primary"><%= I18n.translate(locale, "Search") %></button>
    <% unless history_query.empty? %>
    <a href="<%= HTML.escape(history_clear_url) %>"><%= I18n.translate(locale, "history_clear_search") %></a>
    <% end %>
</form>
<% if watched.empty? %>
<p class="h-box"><%= I18n.translate(locale, history_query.empty? ? "history_empty" : "history_no_matches") %></p>
<% end %>

<script id="watched_data" type="application/json">
<%=
{
    "csrf_token" => URI.encode_www_form(env.get?("csrf_token").try &.as(String) || "")
}.to_pretty_json
%>
</script>
<script src="/js/watched_widget.js"></script>

<% previous_group = "" %>
<div class="history-groups">
    <% watched.each do |entry| %>
        <% item = entry.video_id %>
        <% group = Invidious::History.group(entry.latest_watched, history_today) %>
        <% if group != previous_group %>
            <% unless previous_group.empty? %></div></section><% end %>
            <section class="history-group">
            <h2><%= I18n.translate(locale, group) %></h2>
            <div class="pure-g media-grid">
            <% previous_group = group %>
        <% end %>
        <div class="pure-u-1 pure-u-md-1-4 media-item" data-kind="video">
            <div class="h-box media-card">
                <div class="thumbnail">
                    <% unless env.get("preferences").as(Preferences).thin_mode %>
                    <a style="width:100%" href="/watch?v=<%= HTML.escape(item) %>" aria-label="<%= I18n.translate(locale, "ui_open_video") %> <%= HTML.escape(item) %>">
                        <img loading="lazy" width="320" height="180" class="thumbnail" src="/vi/<%= HTML.escape(item) %>/mqdefault.jpg" alt="" />
                    </a>
                    <% else %>
                    <div class="thumbnail-placeholder"></div>
                    <% end %>

                    <div class="top-left-overlay"><div class="watched">
                    <form data-onsubmit="return_false" action="/watch_ajax?action=mark_unwatched&id=<%= HTML.escape(item) %>&referer=<%= env.get("current_page") %>" method="post">
                        <input type="hidden" name="csrf_token" value="<%= URI.encode_www_form(env.get?("csrf_token").try &.as(String) || "") %>">
                        <button type="submit" class="pure-button pure-button-secondary low-profile"
                                data-onclick="mark_unwatched" data-id="<%= HTML.escape(item) %>" aria-label="<%= I18n.translate(locale, "ui_remove_history") %>"><i class="icon ion-md-trash" aria-hidden="true"></i></button>
                    </form>
                    </div></div>
                </div>
                <p><a href="/watch?v=<%= HTML.escape(item) %>" dir="auto" data-dearrow-id="<%= HTML.escape(item) %>"><%= HTML.escape(entry.title || "#{I18n.translate(locale, "ui_open_video")} (#{item})") %></a></p>
                <p dir="auto">
                    <% if channel_id = entry.channel_id %>
                    <a href="/channel/<%= URI.encode_www_form(channel_id) %>"><%= HTML.escape(entry.channel_name || channel_id) %></a>
                    <% else %>
                    <%= HTML.escape(entry.channel_name || I18n.translate(locale, "history_channel_unknown")) %>
                    <% end %>
                </p>
                <p><%= I18n.translate(locale, "history_released") %>: <%= HTML.escape(entry.release_date || I18n.translate(locale, "history_date_unknown")) %></p>
                <p><%= I18n.translate(locale, "history_watched") %>: <%= HTML.escape(entry.latest_watched || I18n.translate(locale, "history_watch_date_unknown")) %></p>
            </div>
        </div>
    <% end %>
    <% unless previous_group.empty? %></div></section><% end %>
</div>

<%=
  IV::Frontend::Pagination.nav_numeric(locale,
    base_url: base_url,
    current_page: page,
    show_next: (max_results > 0 && page.to_i64 * max_results < history_count)
  )
%>

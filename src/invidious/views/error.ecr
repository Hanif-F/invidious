<% content_for "header" do %>
<title><%= HTML.escape(error_heading) %> - Invidious</title>
<% end %>

<section class="reading-page status-panel error-page" aria-labelledby="error-heading">
<p class="muted"><%= env.response.status_code %></p>
<h1 id="error-heading" dir="auto"><%= HTML.escape(error_heading) %></h1>
<p dir="auto" class="error-reason"><%= HTML.escape(error_message) %></p>
<% unless {"GET", "HEAD"}.includes?(env.request.method) %><p dir="auto" class="form-feedback"><%= I18n.translate(locale, "error_write_guidance") %></p><% end %>
<nav class="toolbar" aria-label="<%= I18n.translate(locale, "error_recovery") %>"><% error_actions.each do |label, destination| %><a class="button" href="<%= HTML.escape(destination) %>" rel="noopener noreferrer" <% if Invidious::Frontend::ErrorPages.embedded?(env) %>target="_blank"<% end %>><%= I18n.translate(locale, label) %></a><% end %></nav>
<% if diagnostics = error_diagnostics %>
<details class="error-details"><summary><%= I18n.translate(locale, "error_technical_details") %></summary><p dir="auto" class="muted"><%= I18n.translate(locale, "error_report_guidance") %></p><pre><%= HTML.escape(diagnostics) %></pre><div class="toolbar"><a class="button" href="https://github.com/iv-org/documentation/blob/master/docs/faq.md" rel="noreferrer noopener"><%= I18n.translate(locale, "error_faq") %></a><a class="button" href="https://github.com/iv-org/invidious/issues" rel="noreferrer noopener"><%= I18n.translate(locale, "error_find_issues") %></a><a class="button" href="https://github.com/iv-org/invidious/issues/new?labels=bug&amp;template=bug_report.md" rel="noreferrer noopener"><%= I18n.translate(locale, "error_report_issue") %></a></div></details>
<% end %>
</section>

<% ucid = video.ucid %>
<% spoiler_date = Invidious::ChannelSpoilers.video_publication(video.info) %>
<% original_title = native_clip ? native_clip.title : Invidious::OriginalTitles.title(env, video.id, video.title) %>
<% spoiler_title_hidden = Invidious::Frontend::ChannelSpoilers.hidden?(env, video.ucid, spoiler_date, :title) %>
<% title = HTML.escape(spoiler_title_hidden ? Invidious::Frontend::ChannelSpoilers.label(env, :title, spoiler_date.nil?) : original_title) %>
<% display_thumbnail = Invidious::Frontend::ChannelSpoilers.hidden?(env, video.ucid, spoiler_date, :thumbnail) ? "" : thumbnail %>
<% env.set "spoiler_page", {"channel" => video.ucid, "published" => spoiler_date.try(&.to_unix), "title" => original_title, "thumbnail" => thumbnail}.to_json %>
<% Invidious::Frontend::ChannelSpoilers.prepare_recommendations(env, related_videos) %>
<% Invidious::Frontend::ViewCounts.prepare_recommendations(env, video, related_videos) %>
<% watch_url = native_clip ? native_clip.permalink : "/watch?v=#{video.id}" %>
<% author = HTML.escape(video.author) %>


<% content_for "header" do %>
<meta name="thumbnail" content="<%= display_thumbnail %>">
<meta name="description" content="<%= HTML.escape(video.short_description) %>">
<meta name="keywords" content="<%= video.keywords.join(",") %>">
<meta property="og:site_name" content="<%= author %> | Invidious">
<meta property="og:url" content="<%= HOST_URL %><%= watch_url %>">
<% if native_clip %><link rel="canonical" href="<%= HOST_URL %><%= watch_url %>"><% end %>
<meta property="og:title" content="<%= title %>">
<meta property="og:image" content="<%= display_thumbnail.empty? ? "" : HOST_URL + display_thumbnail %>">
<meta property="og:description" content="<%= HTML.escape(video.short_description) %>">
<meta property="og:type" content="video.other">
<% unless native_clip %>
<meta property="og:video:url" content="<%= HOST_URL %>/embed/<%= video.id %>">
<meta property="og:video:secure_url" content="<%= HOST_URL %>/embed/<%= video.id %>">
<meta property="og:video:type" content="text/html">
<meta property="og:video:width" content="1280">
<meta property="og:video:height" content="720">
<% end %>
<meta name="twitter:card" content="<%= native_clip ? "summary_large_image" : "player" %>">
<meta name="twitter:url" content="<%= HOST_URL %><%= watch_url %>">
<meta name="twitter:title" content="<%= title %>">
<meta name="twitter:description" content="<%= HTML.escape(video.short_description) %>">
<meta name="twitter:image" content="<%= display_thumbnail.empty? ? "" : HOST_URL + display_thumbnail %>">
<% unless native_clip %>
<meta name="twitter:player" content="<%= HOST_URL %>/embed/<%= video.id %>">
<meta name="twitter:player:width" content="1280">
<meta name="twitter:player:height" content="720">
<% end %>
<link rel="alternate" href="https://www.youtube.com/watch?v=<%= video.id %>">
<%= rendered "components/player_sources" %>
<link rel="stylesheet" href="/css/watch-tools.css?v=<%= ASSET_COMMIT %>">
<% if video.live_chat_replay? %><link rel="stylesheet" href="/css/live-chat.css?v=<%= ASSET_COMMIT %>"><link rel="stylesheet" href="/css/chat-preferences.css?v=<%= ASSET_COMMIT %>"><% end %>
<title><%= title %> - Invidious</title>

<noscript><style>.js-only { display: none !important }</style></noscript>

<% end %>

<script id="video_data" type="application/json">
<%=
{
    "id" => video.id,
    "channel_id" => video.ucid,
    "clip" => (native_clip || preview_clip) ? {"url" => native_clip.try(&.permalink), "startTime" => params.video_start, "endTime" => params.video_end} : nil,
    "index" => continuation,
    "playlist_current_removed" => env.params.query["playlist_current_removed"]? == "1" || env.get?("playlist_occurrence_missing") == true,
    "playlist_occurrence" => env.get?("playlist_occurrence").try(&.as(String)),
    "plid" => plid,
    "length_seconds" => video.length_seconds.to_f,
    "skip_playback_position" => video.music_genre?,
    "record_completion" => !!user.try(&.preferences.watch_history),
    "playback_sync" => playback_sync,
    "playback_position" => playback_position,
    "csrf_token" => env.get?("csrf_token").try(&.as(String)) || "",
    "play_next" => !native_clip && !preview_clip && !related_videos.empty? && !plid && params.continue,
    "next_video" => related_videos.select { |rv| rv["id"]? }[0]?.try &.["id"],
    "youtube_comments_text" => HTML.escape(I18n.translate(locale, "View YouTube comments")),
    "comments_youtube_disabled_text" => HTML.escape(I18n.translate(locale, "comments_youtube_disabled_text")),
    "comments_text" => HTML.escape(I18n.translate(locale, "View `x` comments", "{commentCount}")),
    "hide_replies_text" => HTML.escape(I18n.translate(locale, "Hide replies")),
    "show_replies_text" => HTML.escape(I18n.translate(locale, "Show replies")),
    "params" => params,
    "preferences" => preferences,
    "premiere_timestamp" => video.premiere_timestamp.try &.to_unix,
    "vr" => video.vr?,
    "comments_enabled" => video.comments?,
    "projection_type" => video.projection_type,
    "local_disabled" => CONFIG.disabled?("local"),
    "live_now" => video.live_now,
    "chat_account" => !!user,
    "chat_timing_ms" => chat_timing_ms
}.to_pretty_json.gsub("<", "\\u003c")
%>
</script>
<script id="config" type="application/json">
<%=
{
    "videojs" => CONFIG.videojs,
}.to_pretty_json.gsub("<", "\\u003c")
%>
</script>

<script id="watch_ui_data" type="application/json"><%=
{
    "loading" => I18n.translate(locale, "ui_loading"),
    "retry" => I18n.translate(locale, "ui_retry"),
    "queue_error" => I18n.translate(locale, "ui_queue_error"),
    "queue_remove" => I18n.translate(locale, "Remove from this playlist"),
    "queue_removed" => I18n.translate(locale, "Video removed from playlist"),
    "queue_remove_error" => I18n.translate(locale, "Could not remove video; try again"),
    "queue_uncertain" => I18n.translate(locale, "overhaul_queue_uncertain"),
    "queue_filtered_empty" => I18n.translate(locale, "overhaul_queue_filtered_empty"),
    "queue_refresh" => I18n.translate(locale, "overhaul_queue_refresh"),
    "queue_empty" => I18n.translate(locale, "ui_queue_empty"),
    "queue_end" => I18n.translate(locale, "ui_queue_end"),
    "now_playing" => I18n.translate(locale, "ui_now_playing"),
    "previous" => I18n.translate(locale, "ui_previous_video"),
    "next" => I18n.translate(locale, "ui_next_video"),
    "show_queue" => I18n.translate(locale, "ui_show_queue"),
    "hide_queue" => I18n.translate(locale, "ui_hide_queue"),
    "share" => I18n.translate(locale, "ui_share"),
    "wide_player" => I18n.translate(locale, "ui_wide_player"),
    "copied" => I18n.translate(locale, "ui_copied"),
    "transcript_error" => I18n.translate(locale, "ui_transcript_error"),
    "transcript_unavailable" => I18n.translate(locale, "overhaul_transcript_unavailable"),
    "transcript_empty" => I18n.translate(locale, "ui_transcript_empty"),
    "no_matches" => I18n.translate(locale, "ui_no_matches"),
    "auto_generated" => I18n.translate(locale, "ui_auto_generated"),
    "transcript_script" => "/js/transcript.js?v=#{ASSET_COMMIT}",
    "chat_loading" => I18n.translate(locale, "ui_chat_loading"),
    "chat_unavailable" => I18n.translate(locale, "ui_chat_unavailable"),
    "chat_error" => I18n.translate(locale, "ui_chat_error"),
    "chat_empty" => I18n.translate(locale, "ui_chat_empty"),
    "chat_waiting" => I18n.translate(locale, "overhaul_chat_waiting"),
    "chat_filtered_empty" => I18n.translate(locale, "overhaul_chat_filtered_empty"),
    "chat_seek" => I18n.translate(locale, "overhaul_chat_seek"),
    "show_chat" => I18n.translate(locale, "ui_show_chat"),
    "hide_chat" => I18n.translate(locale, "ui_hide_chat"),
    "chat_settings" => I18n.translate(locale, "ui_chat_settings"),
    "chat_invalid_pattern" => I18n.translate(locale, "ui_chat_invalid_pattern"),
    "chat_save_error" => I18n.translate(locale, "ui_chat_save_error"),
}.to_json
%></script>
<%
  avatar_ids = [video.ucid] + related_videos.compact_map { |entry| entry["ucid"]? }
  supplied_avatars = {} of String => String
  supplied_avatars[video.ucid] = video.author_thumbnail unless video.author_thumbnail.empty?
  Invidious::Frontend::ChannelAvatars.prepare_ids(env, avatar_ids, supplied_avatars)
  has_transcript = !video.captions.empty?
  chapters = Invidious::Videos::Chapters.from_descriptions(video.short_description, video.description_html, video.live_now ? 0 : video.length_seconds)
  has_timestamps = params.controls && !chapters.empty?
  has_tools = !!plid || video.live_chat_replay? || params.related_videos
  clip_available = Invidious::Clips.source_error(video).nil?
  clip_inline = !!user && clip_available
  listen_params = env.params.query.dup
  listen_params["listen"] = params.listen ? "0" : "1"
  listen_url = "#{native_clip ? native_clip.permalink : "/watch"}?#{listen_params}"
%>
<div class="watch-grid <%= "watch-no-tools" unless has_tools %>" id="watch-layout">
<div class="watch-player"><div id="player-container"><%= rendered "components/player" %></div></div>
<div class="watch-primary">
<%= rendered "overhaul/watch_heading" %>
<div class="creator-actions">
<div class="creator"><a href="/channel/<%= HTML.escape(video.ucid) %>" class="creator"><%= Invidious::Frontend::ChannelAvatars.render(env, video.ucid, 40, video.author) %><strong dir="auto"><%= author %></strong><% if video.author_verified %><span aria-label="<%= I18n.translate(locale, "ui_verified") %>"><%= Invidious::Frontend::Icons.render("check") %></span><% end %></a><% sub_count_text = video.sub_count_text %><%= rendered "overhaul/subscribe" %></div>
<div class="toolbar watch-actions" data-video-actions data-video-id="<%= HTML.escape(video.id) %>" aria-label="<%= I18n.translate(locale, "ui_more_tools") %>">
<% if user %><a class="button" href="/feed/playlists?video_id=<%= HTML.escape(video.id) %>" data-video-action="playlist" aria-haspopup="dialog"><%= Invidious::Frontend::Icons.render("bookmark") %><%= I18n.translate(locale, "overhaul_save") %></a><% elsif CONFIG.login_enabled %><a class="button" href="/login?referer=<%= URI.encode_www_form("/feed/playlists?video_id=#{video.id}") %>"><%= Invidious::Frontend::Icons.render("bookmark") %><%= I18n.translate(locale, "overhaul_save") %></a><% end %>
<button class="button js-only" id="share-video" type="button"><%= Invidious::Frontend::Icons.render("share-2") %><%= I18n.translate(locale, "ui_share") %></button>
<% if clip_available %><a class="button" id="create-clip" href="/create_clip?videoId=<%= HTML.escape(video.id) %>"><%= Invidious::Frontend::Icons.render("scissors") %><span data-clip-label><%= I18n.translate(locale, "overhaul_clip") %></span></a><% end %>
<details class="ui-menu video-context" data-ui-menu data-video-id="<%= HTML.escape(video.id) %>" data-channel-id="<%= HTML.escape(video.ucid) %>" data-channel-name="<%= HTML.escape(video.author) %>"><summary class="button"><%= Invidious::Frontend::Icons.render("ellipsis-vertical") %><%= I18n.translate(locale, "overhaul_more") %></summary><div class="menu-content video-context-actions">
<a id="link-iv-listen" data-base-url="<%= HTML.escape(listen_url) %>" href="<%= HTML.escape(listen_url) %>"><%= Invidious::Frontend::Icons.render(params.listen ? "play" : "headphones") %><%= I18n.translate(locale, params.listen ? "Video mode" : "Audio mode") %></a>
<button class="js-only" type="button" data-open-dialog="download-dialog"><%= Invidious::Frontend::Icons.render("download") %><%= I18n.translate(locale, "Download") %></button><noscript><a href="#download-fallback"><%= Invidious::Frontend::Icons.render("download") %><%= I18n.translate(locale, "Download") %></a></noscript>
<% if has_transcript %><button class="js-only" id="transcript-toggle" type="button" aria-controls="transcript-panel" aria-expanded="false"><%= Invidious::Frontend::Icons.render("captions") %><%= I18n.translate(locale, "ui_transcript") %></button><% end %>
<% unless native_clip %><% if user && Invidious::DeArrow::IdentityCipher.ready?(CONFIG.dearrow_identity_key) %><button class="js-only" type="button" id="dearrow-open" aria-haspopup="dialog"><%= Invidious::Frontend::Icons.render("rotate-cw") %><%= I18n.translate(locale, "dearrow_contribute") %></button><noscript><span class="menu-note"><%= I18n.translate(locale, "overhaul_dearrow_nojs") %></span><a href="/preferences/dearrow/identity"><%= Invidious::Frontend::Icons.render("lock") %><%= I18n.translate(locale, "overhaul_identity_heading") %></a></noscript><% else %><a href="/preferences?section=dearrow"><%= Invidious::Frontend::Icons.render("rotate-cw") %><%= I18n.translate(locale, "dearrow_contribute") %></a><% end %><% end %>
<% unless native_clip %><hr><%= rendered "overhaul/watch_destinations" %><% end %>
</div></details></div></div>
<p id="share-status" role="status"></p><div id="share-fallback" hidden><label for="share-url"><%= I18n.translate(locale, "ui_share") %></label><input id="share-url" type="url" readonly></div>
<%= rendered "overhaul/watch_description" %>
</div>
<% if has_tools || has_transcript || has_timestamps || clip_inline %>
<aside class="utility-panel" id="watch-sidebar" <%= "hidden" unless has_tools %> aria-label="<%= I18n.translate(locale, "overhaul_video_tools") %>">
<div id="watch-tools">
<% if has_transcript %><%= rendered "overhaul/watch_transcript" %><% end %>
<% if has_timestamps %><%= rendered "overhaul/watch_timestamps" %><% end %>
<% if video.live_chat_replay? %><%= rendered "overhaul/watch_chat" %><% end %>
<% if plid %><%= rendered "overhaul/watch_queue" %><% end %>
<% if params.related_videos %><section class="watch-tool recommendations" id="tool-next" aria-labelledby="recommendations-heading"><h2 id="recommendations-heading"><%= I18n.translate(locale, "overhaul_up_next") %></h2>
<% if !native_clip && !preview_clip && !plid %><div class="continue-control" <%= "hidden" if related_videos.empty? %>><label><input id="continue" name="continue" type="checkbox" <%= "checked" if params.continue %>><%= I18n.translate(locale, "preferences_continue_label") %></label></div><% end %>
<div id="watch-recommendation-items"><%= rendered "overhaul/watch_recommendations" %></div>
</section><% end %>
</div>
<% if clip_inline %><%= rendered "overhaul/watch_clip_editor" %><% end %>
</aside><% end %>
<%= rendered "overhaul/watch_comments" %>
</div>
<% unless native_clip %><% env.set "dearrow_hide_entry", true %><%= rendered "components/dearrow_contributions" %><% end %>
<dialog id="download-dialog" aria-labelledby="download-heading"><header class="dialog-heading"><h2 id="download-heading"><%= I18n.translate(locale, "Download") %></h2><form method="dialog"><button class="icon-button" aria-label="<%= I18n.translate(locale, "Close") %>"><%= Invidious::Frontend::Icons.render("x") %></button></form></header></dialog>
<details id="download-fallback"><summary><%= I18n.translate(locale, "Download") %></summary><div id="download-options"><%= Invidious::Frontend::WatchPage.download_widget(locale, video, video_assets, spoiler_title_hidden ? Invidious::Frontend::ChannelSpoilers.label(env, :title, spoiler_date.nil?) : original_title) %></div></details>
<%= rendered "overhaul/watch_clip_config" %>
<script src="/js/comment-threads.js?v=<%= ASSET_COMMIT %>"></script><script src="/js/watch.js?v=<%= ASSET_COMMIT %>"></script><script src="/js/player-ui.js?v=<%= ASSET_COMMIT %>"></script><script src="/js/player-dock.js?v=<%= ASSET_COMMIT %>"></script>
<% if video.live_chat_replay? %><script src="/js/chat-preferences.js?v=<%= ASSET_COMMIT %>"></script><script src="/js/chat-timing.js?v=<%= ASSET_COMMIT %>"></script><script src="/js/live-chat.js?v=<%= ASSET_COMMIT %>"></script><% end %>

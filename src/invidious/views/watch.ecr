<% ucid = video.ucid %>
<% title = HTML.escape(video.title) %>
<% author = HTML.escape(video.author) %>


<% content_for "header" do %>
<meta name="thumbnail" content="<%= thumbnail %>">
<meta name="description" content="<%= HTML.escape(video.short_description) %>">
<meta name="keywords" content="<%= video.keywords.join(",") %>">
<meta property="og:site_name" content="<%= author %> | Invidious">
<meta property="og:url" content="<%= HOST_URL %>/watch?v=<%= video.id %>">
<meta property="og:title" content="<%= title %>">
<meta property="og:image" content="<%= HOST_URL %>/vi/<%= video.id %>/maxres.jpg">
<meta property="og:description" content="<%= HTML.escape(video.short_description) %>">
<meta property="og:type" content="video.other">
<meta property="og:video:url" content="<%= HOST_URL %>/embed/<%= video.id %>">
<meta property="og:video:secure_url" content="<%= HOST_URL %>/embed/<%= video.id %>">
<meta property="og:video:type" content="text/html">
<meta property="og:video:width" content="1280">
<meta property="og:video:height" content="720">
<meta name="twitter:card" content="player">
<meta name="twitter:url" content="<%= HOST_URL %>/watch?v=<%= video.id %>">
<meta name="twitter:title" content="<%= title %>">
<meta name="twitter:description" content="<%= HTML.escape(video.short_description) %>">
<meta name="twitter:image" content="<%= HOST_URL %>/vi/<%= video.id %>/maxres.jpg">
<meta name="twitter:player" content="<%= HOST_URL %>/embed/<%= video.id %>">
<meta name="twitter:player:width" content="1280">
<meta name="twitter:player:height" content="720">
<link rel="alternate" href="https://www.youtube.com/watch?v=<%= video.id %>">
<%= rendered "components/player_sources" %>
<title><%= title %> - Invidious</title>

<noscript><style>.js-only, #try-reddit-comments-link { display: none !important }</style></noscript>

<% end %>

<script id="video_data" type="application/json">
<%=
{
    "id" => video.id,
    "index" => continuation,
    "playlist_current_removed" => env.params.query["playlist_current_removed"]? == "1",
    "plid" => plid,
    "length_seconds" => video.length_seconds.to_f,
    "playback_sync" => playback_sync,
    "playback_position" => playback_position,
    "csrf_token" => env.get?("csrf_token").try(&.as(String)) || "",
    "play_next" => !related_videos.empty? && !plid && params.continue,
    "next_video" => related_videos.select { |rv| rv["id"]? }[0]?.try &.["id"],
    "youtube_comments_text" => HTML.escape(I18n.translate(locale, "View YouTube comments")),
    "comments_youtube_disabled_text" => HTML.escape(I18n.translate(locale, "comments_youtube_disabled_text")),
    "comments_youtube_disabled_try_reddit" => HTML.escape(I18n.translate(locale, "comments_youtube_disabled_try_reddit")),
    "reddit_comments_text" => HTML.escape(I18n.translate(locale, "View Reddit comments")),
    "reddit_permalink_text" => HTML.escape(I18n.translate(locale, "View more comments on Reddit")),
    "comments_text" => HTML.escape(I18n.translate(locale, "View `x` comments", "{commentCount}")),
    "hide_replies_text" => HTML.escape(I18n.translate(locale, "Hide replies")),
    "show_replies_text" => HTML.escape(I18n.translate(locale, "Show replies")),
    "params" => params,
    "preferences" => preferences,
    "premiere_timestamp" => video.premiere_timestamp.try &.to_unix,
    "vr" => video.vr?,
    "comments_enabled" => video.comments?,
    "projection_type" => video.projection_type,
    "local_disabled" => CONFIG.disabled?("local"),
    "support_reddit" => true,
    "live_now" => video.live_now
}.to_pretty_json
%>
</script>
<script id="config" type="application/json">
<%=
{
    "videojs" => CONFIG.videojs,
}.to_pretty_json
%>
</script>

<script id="watch_ui_data" type="application/json"><%=
{
    "loading" => I18n.translate(locale, "ui_loading"),
    "retry" => I18n.translate(locale, "ui_retry"),
    "queue_error" => I18n.translate(locale, "ui_queue_error"),
    "queue_remove" => I18n.translate(locale, "Remove from this playlist"),
    "queue_removed" => I18n.translate(locale, "Video removed from playlist"),
    "queue_remove_error" => I18n.translate(locale, "Could not remove video; try again"),
    "queue_empty" => I18n.translate(locale, "ui_queue_empty"),
    "queue_end" => I18n.translate(locale, "ui_queue_end"),
    "now_playing" => I18n.translate(locale, "ui_now_playing"),
    "previous" => I18n.translate(locale, "ui_previous_video"),
    "next" => I18n.translate(locale, "ui_next_video"),
    "show_queue" => I18n.translate(locale, "ui_show_queue"),
    "hide_queue" => I18n.translate(locale, "ui_hide_queue"),
    "share" => I18n.translate(locale, "ui_share"),
    "wide_player" => I18n.translate(locale, "ui_wide_player"),
    "copied" => I18n.translate(locale, "ui_copied"),
    "transcript_error" => I18n.translate(locale, "ui_transcript_error"),
    "transcript_empty" => I18n.translate(locale, "ui_transcript_empty"),
    "no_matches" => I18n.translate(locale, "ui_no_matches"),
    "auto_generated" => I18n.translate(locale, "ui_auto_generated"),
    "transcript_script" => "/js/transcript.js?v=#{ASSET_COMMIT}",
}.to_json
%></script>
<div class="watch-layout watch-wide<%= " watch-without-sidebar" unless params.related_videos || plid %>" id="watch-layout">
    <div class="watch-player">
        <div id="player-container"><%= rendered "components/player" %></div>
    </div>
    <div class="watch-primary">
        <header class="watch-heading">
            <h1 dir="auto"><%= title %></h1>
    <% if !video.is_listed %>
        <h3>
            <i class="icon ion-ios-unlock"></i> <%= I18n.translate(locale, "Unlisted") %>
        </h3>
    <% end %>

    <% if video.reason %>
        <h3>
            <%= video.reason %>
        </h3>
    <% elsif video.premiere_timestamp.try &.> Time.utc %>
        <h3>
            <%= video.premiere_timestamp.try { |t| I18n.translate(locale, "Premieres in `x`", recode_date((t - Time.utc).ago, locale)) } %>
        </h3>
    <% elsif video.live_now %>
        <h3>
            <%= video.premiere_timestamp.try { |t| I18n.translate(locale, "videoinfo_started_streaming_x_ago", recode_date((Time.utc - t).ago, locale)) } %>
        </h3>
    <% end %>
            <div class="video-stats">
                <p id="views"><%= I18n.translate_count(locale, "generic_views_count", video.views, I18n::NumberFormatting::Short) %></p>
                <p id="likes"><i class="icon ion-ios-thumbs-up" aria-hidden="true"></i> <%= number_with_separator(video.likes) %> <%= I18n.translate(locale, "ui_likes") %></p>
                <p id="published-date"><% if video.premiere_timestamp.try &.> Time.utc %>
                    <%= I18n.translate(locale, "Premieres `x`", video.premiere_timestamp.not_nil!.to_s("%B %-d, %R UTC")) %>
                <% else %>
                    <%= I18n.translate(locale, "Shared `x`", video.published.to_s("%B %-d, %Y")) %>
                <% end %></p>
            </div>
        </header>
        <div class="watch-channel">
            <a href="/channel/<%= video.ucid %>" class="channel-profile">
                <% if !video.author_thumbnail.empty? %><img width="48" height="48" src="/ggpht<%= URI.parse(video.author_thumbnail).request_target %>" alt=""><% end %>
                <span class="channel-name" dir="auto"><%= author %><% if video.author_verified %> <i class="icon ion-md-checkmark-circle" title="<%= I18n.translate(locale, "ui_verified") %>"></i><% end %></span>
            </a>
            <div><% sub_count_text = video.sub_count_text %><%= rendered "components/subscribe_widget" %></div>
        </div>
        <div class="watch-actions">
            <a class="pure-button" id="link-iv-listen" data-base-url="/watch?<%= env.params.query %>&listen=<%= params.listen ? 0 : 1 %>" href="/watch?<%= env.params.query %>&listen=<%= params.listen ? 0 : 1 %>">
                <i class="icon <%= params.listen ? "ion-ios-videocam" : "ion-md-headset" %>" aria-hidden="true"></i> <%= I18n.translate(locale, params.listen ? "Video mode" : "Audio mode") %>
            </a>
            <button type="button" class="pure-button js-only" id="share-video"><%= I18n.translate(locale, "ui_share") %></button>
            <% if user %><details><summary><%= I18n.translate(locale, "Add to playlist") %></summary><div class="action-content">
            <% if user %>
                <% playlists = Invidious::Database::Playlists.select_user_created_playlists(user.email) %>
                <% if !playlists.empty? %>
                    <form data-onsubmit="return_false" class="pure-form pure-form-stacked" action="/playlist_ajax?action=add_video" method="post" target="_blank">
                        <div class="pure-control-group">
                            <label for="playlist_id"><%= I18n.translate(locale, "Add to playlist: ") %></label>
                            <select style="width:100%" name="playlist_id" id="playlist_id">
                                <% playlists.each do |plid, playlist_title| %>
                                    <option data-plid="<%= plid %>" value="<%= plid %>" <%= "selected" if user.preferences.default_playlist == plid %>><%= HTML.escape(playlist_title) %></option>
                                <% end %>
                            </select>
                        </div>

                        <input type="hidden" name="csrf_token" value="<%= URI.encode_www_form(env.get?("csrf_token").try &.as(String) || "") %>">
                        <input type="hidden" name="video_id" value="<%= video.id %>">
                        <button data-onclick="add_playlist_video" data-id="<%= video.id %>" type="submit" class="pure-button pure-button-primary">
                            <b><%= I18n.translate(locale, "Add to playlist") %></b>
                        </button>
                    </form>
                    <script id="playlist_data" type="application/json">
                    <%=
                    {
                        "csrf_token" => URI.encode_www_form(env.get?("csrf_token").try &.as(String) || "")
                    }.to_pretty_json
                    %>
                    </script>
                    <script src="/js/playlist_widget.js?v=<%= Time.utc.to_unix_ms %>"></script>
                <% end %>
            <% end %>




                <p id="playlist-save-status" role="status" data-saved="<%= I18n.translate(locale, "ui_saved_playlist") %>" data-error="<%= I18n.translate(locale, "ui_save_error") %>"></p>
                <a href="/create_playlist"><%= I18n.translate(locale, "Create playlist") %></a>
            </div></details><% end %>
            <details><summary><%= I18n.translate(locale, "Download") %></summary><div class="action-content">
                <%= Invidious::Frontend::WatchPage.download_widget(locale, video, video_assets) %>
            </div></details>
            <details><summary><%= I18n.translate(locale, "ui_more_tools") %></summary><div class="action-content">
            <span id="watch-on-youtube">
                <%-
                    link_yt_watch = URI.new(scheme: "https", host: "www.youtube.com", path: "/watch", query: "v=#{video.id}")
                    link_yt_embed = URI.new(scheme: "https", host: "www.youtube.com", path: "/embed/#{video.id}")

                    if !plid.nil? && !continuation.nil?
                        link_yt_param = URI::Params{"list" => [plid], "index" => [continuation.to_s]}
                        link_yt_watch = IV::HttpServer::Utils.add_params_to_url(link_yt_watch, link_yt_param)
                        link_yt_embed = IV::HttpServer::Utils.add_params_to_url(link_yt_embed, link_yt_param)
                    end
                -%>
                <a id="link-yt-watch" rel="noreferrer noopener" data-base-url="<%= link_yt_watch %>" href="<%= link_yt_watch %>"><%= I18n.translate(locale, "videoinfo_watch_on_youTube") %></a>
                (<a id="link-yt-embed" referrerpolicy="origin-when-cross-origin" rel="noopener" data-base-url="<%= link_yt_embed %>" href="<%= link_yt_embed %>"><%= I18n.translate(locale, "videoinfo_youTube_embed_link") %></a>)
            </span>

            <p id="watch-on-another-invidious-instance">
                <%- link_iv_other = IV::Frontend::Misc.redirect_url(env) -%>
                <a id="link-iv-other" data-base-url="<%= link_iv_other %>" href="<%= link_iv_other %>"><%= I18n.translate(locale, "Switch Invidious Instance") %></a>
            </p>

            <p id="embed-link">
                <%-
                    params_iv_embed = env.params.query.dup
                    params_iv_embed.delete_all("v")

                    link_iv_embed = URI.new(path: "/embed/#{id}")
                    link_iv_embed = IV::HttpServer::Utils.add_params_to_url(link_iv_embed, params_iv_embed)
                -%>
                <a id="link-iv-embed" data-base-url="<%= link_iv_embed %>" href="<%= link_iv_embed %>"><%= I18n.translate(locale, "videoinfo_invidious_embed_link") %></a>
            </p>

            <p id="annotations">
                <% if params.annotations %>
                    <a href="/watch?<%= env.params.query %>&iv_load_policy=3">
                        <%= I18n.translate(locale, "Hide annotations") %>
                    </a>
                <% else %>
                    <a href="/watch?<%= env.params.query %>&iv_load_policy=1">
                        <%=I18n.translate(locale, "Show annotations")%>
                    </a>
                <% end %>
            </p>


            </div></details>
        </div>
        <p id="share-status" role="status"></p>
        <div id="share-fallback" hidden class="pure-form"><label for="share-url"><%= I18n.translate(locale, "ui_share") %></label><input id="share-url" readonly type="url"></div>
        <section class="watch-description panel">
            <div class="panel-body">
                <details id="description-box" <%= "open" if params.extend_desc || video.description.size < 200 %>>
                    <summary><%= I18n.translate(locale, "ui_description") %></summary>
                    <div id="descriptionWrapper"><%= video.description_html %></div>
                </details>
                <section id="timestamp-panel" hidden><h3><%= I18n.translate(locale, "ui_timestamps") %></h3><ol id="timestamp-list" class="timestamp-list"></ol></section>
                <% if !video.captions.empty? %>
                <details id="transcript-panel" class="js-only">
                    <summary><%= I18n.translate(locale, "ui_transcript") %></summary>
                    <div class="transcript-toolbar pure-form">
                        <label for="transcript-language"><%= I18n.translate(locale, "ui_language") %><select id="transcript-language">
                            <% video.captions.each do |caption| %><option value="<%= HTML.escape(caption.name) %>" data-auto="<%= caption.auto_generated %>"><%= HTML.escape(caption.name) %></option><% end %>
                        </select></label>
                        <label for="transcript-search"><%= I18n.translate(locale, "ui_search_transcript") %><input type="search" id="transcript-search"></label>
                    </div>
                    <p id="transcript-status" role="status"></p>
                    <button type="button" id="transcript-retry" class="pure-button" hidden><%= I18n.translate(locale, "ui_retry") %></button>
                    <div id="transcript-lines" class="transcript-lines"></div>
                </details>
                <% end %>
                <details class="video-details"><summary><%= I18n.translate(locale, "ui_video_details") %></summary><div class="metadata-grid">
            <p id="genre"><%= I18n.translate(locale, "Genre: ") %>
                <% if !video.genre_url %>
                    <%= video.genre %>
                <% else %>
                    <a href="<%= video.genre_url %>"><%= video.genre %></a>
                <% end %>
            </p>
            <% if video.license %>
                <% if video.license.empty? %>
                    <p id="license"><%= I18n.translate(locale, "License: ") %><%= I18n.translate(locale, "Standard YouTube license") %></p>
                <% else %>
                    <p id="license"><%= I18n.translate(locale, "License: ") %><%= video.license %></p>
                <% end %>
            <% end %>
            <p id="family_friendly"><%= I18n.translate(locale, "Family friendly? ") %><%= I18n.translate_bool(locale, video.is_family_friendly) %></p>
            <p id="wilson" style="display: none; visibility: hidden;"></p>
            <p id="rating" style="display: none; visibility: hidden;"></p>
            <p id="engagement" style="display: none; visibility: hidden;"></p>
            <% if video.allowed_regions.size != REGIONS.size %>
                <p id="allowed_regions">
                    <% if video.allowed_regions.size < REGIONS.size // 2 %>
                        <%= I18n.translate(locale, "Whitelisted regions: ") %><%= video.allowed_regions.join(", ") %>
                    <% else %>
                        <%= I18n.translate(locale, "Blacklisted regions: ") %><%= (REGIONS.to_a - video.allowed_regions).join(", ") %>
                    <% end %>
                </p>
            <% end %>

                </div><% if !video.music.empty? %>
    <h3><%= I18n.translate(locale, "Music in this video") %></h3>
    <% video.music.each do |music| %>
        <div class="music-item">
            <p><strong><%= HTML.escape(music.song) %></strong></p>
            <p><%= HTML.escape(music.artist) %> · <%= HTML.escape(music.album) %></p>
        </div>
    <% end %>
<% end %></details>
            </div>
        </section>
            <div id="comments" class="comments">
                <% if (params.comments <=> ["", ""]) == 0 %>
                    <div id="comments-disabled-message" class="h-box v-box">
                        <p><b><%= HTML.escape(I18n.translate(locale, "comments_invidious_disabled_text")) %></b></p>
                    </div>
                <% else %>
                    <% if video.comments? %>
                        <% if nojs %>
                            <%= comment_html %>
                        <% else %>
                            <noscript>
                                <a href="/watch?<%= env.params.query %>&nojs=1">
                                    <%= I18n.translate(locale, "Hi! Looks like you have JavaScript turned off. Click here to view comments, keep in mind they may take a bit longer to load.") %>
                                </a>
                            </noscript>
                        <% end %>
                    <% else %>
                        <% if !nojs %>
                            <div id="comments-turned-off-on-video-message" class="h-box v-box">
                                <p><b><%= HTML.escape(I18n.translate(locale, "comments_youtube_disabled_text")) %></b></p>
                                <p><b><button data-comments="reddit" id="try-reddit-comments-link" class="simulated_a">
                                    <%= HTML.escape(I18n.translate(locale, "comments_youtube_disabled_try_reddit")) %>
                                </button></b></p>
                            </div>
                        <% end %>

                        <noscript>
                            <% if nojs %>
                                <%= comment_html %>
                            <% else %>
                                <a href="/watch?<%= env.params.query %>&nojs=1">
                                    <%= HTML.escape(I18n.translate(locale, "comments_youtube_disabled_try_reddit_no_js")) %>
                                </a>
                            <% end %>
                        </noscript>
                    <% end %>
                <% end %>
            </div>
    </div>
    <% if params.related_videos || plid %>
    <aside class="watch-sidebar">
        <% if plid %>
        <section class="queue-panel panel" id="playlist-panel">
            <header class="queue-heading">
                <h2><%= I18n.translate(locale, "ui_playing_playlist") %></h2>
                <a id="queue-title" href="/<%= plid.starts_with?("RD") ? "mix" : "playlist" %>?list=<%= plid %>"><%= I18n.translate(locale, "ui_open_playlist") %></a>
                <p class="queue-context"><span id="queue-count"></span><span id="queue-current"><%= I18n.translate(locale, "ui_now_playing") %>: <%= title %></span></p>
            </header>
            <div id="queue-navigation" class="queue-navigation" hidden></div>
            <p id="queue-status" class="queue-status" role="status"></p>
            <button id="queue-retry" class="pure-button queue-retry" type="button" hidden><%= I18n.translate(locale, "ui_retry") %></button>
            <button id="queue-toggle" class="queue-toggle pure-button js-only" type="button" aria-expanded="false" aria-controls="playlist"><%= I18n.translate(locale, "ui_show_queue") %></button>
            <div id="playlist" class="queue-list"></div>
        </section>
        <% end %>
        <% if params.related_videos %>
        <section class="recommendations panel" aria-labelledby="recommendations-heading">
            <h2 class="panel-heading" id="recommendations-heading"><%= I18n.translate(locale, "ui_recommended") %></h2>
            <% if !plid && !related_videos.empty? %>
            <div class="continue-control"><label for="continue"><%= I18n.translate(locale, "preferences_continue_label") %></label> <input id="continue" name="continue" type="checkbox" <%= "checked" if params.continue %>></div>
            <% end %>
            <% related_videos.each do |rv| %>
                <% if rv["id"]? %>
                <article class="recommendation" data-video-id="<%= rv["id"] %>" data-channel-id="<%= HTML.escape(rv["ucid"]? || "") %>">
                    <div class="thumbnail">
                        <% unless preferences.thin_mode %><a tabindex="-1" href="/watch?v=<%= rv["id"] %>&listen=<%= params.listen %>"><img loading="lazy" width="320" height="180" class="thumbnail" src="/vi/<%= rv["id"] %>/mqdefault.jpg" alt=""></a><% end %>
                        <% if (length = rv["length_seconds"]?.try &.to_i?) && length > 0 %><div class="bottom-right-overlay"><span class="length"><%= recode_length_seconds(length) %></span></div><% end %>
                    </div>
                    <div>
                        <h3 dir="auto"><a href="/watch?v=<%= rv["id"] %>&listen=<%= params.listen %>"><%= HTML.escape(rv["title"]) %></a></h3>
                        <p dir="auto"><% if !(rv["ucid"]? || "").empty? %><a href="/channel/<%= rv["ucid"] %>"><%= HTML.escape(rv["author"]? || "") %></a><% else %><%= HTML.escape(rv["author"]? || "") %><% end %><% if rv["author_verified"]? == "true" %> <i class="icon ion-md-checkmark-circle" title="<%= I18n.translate(locale, "ui_verified") %>"></i><% end %></p>
                        <% if count = rv["short_view_count"]?.presence %><p><%= I18n.translate_count(locale, "generic_views_count", short_text_to_number(count), I18n::NumberFormatting::Short) %></p><% end %>
                        <% if date = rv["published"]?.try { |value| Time.parse_rfc3339(value) rescue nil } %><p><%= I18n.translate(locale, "`x` ago", recode_date(date, locale)) %></p><% end %>
                    </div>
                        <% context_video_id = rv["id"]; context_channel_id = rv["ucid"]? || ""; context_channel_name = rv["author"]? || ""; endpoint_params = "?v=#{rv["id"]}" %>
                        <%= rendered "components/video-context-buttons" %>
                </article>
                <% end %>
            <% end %>
        </section>
        <% end %>
    </aside>
    <% end %>
</div>
<script src="/js/comments.js?v=<%= ASSET_COMMIT %>"></script>
<script src="/js/watch.js?v=<%= ASSET_COMMIT %>"></script>
<script src="/js/player-ui.js?v=<%= ASSET_COMMIT %>"></script>

<% content_for "header" do %><title><%= I18n.translate(locale, "generic_button_edit") %> - <%= HTML.escape(playlist.title) %> - Invidious</title><% end %>
<section class="reading-page playlist-form-page"><header class="page-heading"><h1><%= I18n.translate(locale, "generic_button_edit") %></h1><p dir="auto"><%= HTML.escape(playlist.title) %></p></header>
<form action="/edit_playlist?list=<%= URI.encode_www_form(plid) %>" method="post" data-playlist-form="edit" data-playlist-id="<%= HTML.escape(plid) %>" class="stacked-form">
<% form_title = env.params.body["title"]? || playlist.title; form_privacy = env.params.body["privacy"]? || playlist.privacy.to_s; form_description = env.params.body["description"]? || playlist.description; is_edit = true %>
<%= rendered "overhaul/playlist_fields" %>
<div class="toolbar"><button type="submit" class="button button-primary"><%= Invidious::Frontend::Icons.render("check") %><%= I18n.translate(locale, "generic_button_save") %></button><a class="button" href="/playlist?list=<%= URI.encode_www_form(plid) %>"><%= I18n.translate(locale, "generic_button_cancel") %></a><a class="button button-danger" href="/delete_playlist?list=<%= URI.encode_www_form(plid) %>"><%= Invidious::Frontend::Icons.render("trash-2") %><%= I18n.translate(locale, "Delete playlist") %></a></div>
<input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>">
</form></section>

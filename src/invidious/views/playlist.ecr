<% owned = playlist.is_a?(InvidiousPlaylist) && playlist.author == user.try(&.email); env.set "collection_kind", "playlist" if user %>
<% content_for "header" do %><title><%= HTML.escape(playlist.title) %> - Invidious</title><link rel="alternate" type="application/rss+xml" title="RSS" href="/feed/playlist/<%= HTML.escape(plid) %>"><% end %>
<header class="page-heading"><h1 dir="auto"><%= HTML.escape(playlist.title) %></h1><div class="media-meta">
<% if playlist.is_a?(InvidiousPlaylist) %><span dir="auto"><%= HTML.escape(playlist.display_author) %></span><span class="badge"><%= Invidious::Frontend::Icons.render(playlist.privacy.private? ? "lock" : "globe") %><%= I18n.translate(locale, playlist.privacy.to_s) %></span>
<% elsif !playlist.author.empty? %><% if playlist.ucid && !playlist.ucid.to_s.empty? %><a href="/channel/<%= HTML.escape(playlist.ucid || "") %>" dir="auto"><%= HTML.escape(playlist.author) %></a><% else %><span dir="auto"><%= HTML.escape(playlist.author) %></span><% end %><% elsif subtitle = playlist.subtitle %><span dir="auto"><%= HTML.escape(subtitle) %></span><% end %>
<span data-playlist-count><%= I18n.translate_count(locale, "generic_videos_count", playlist.video_count) %></span><span><%= I18n.translate(locale, "Updated `x` ago", recode_date(playlist.updated, locale)) %></span></div></header>
<div class="toolbar playlist-toolbar">
<% if first_video = items.find { |entry| entry.is_a?(PlaylistVideo) }.as?(PlaylistVideo) %><a class="button button-primary" href="/watch?v=<%= HTML.escape(first_video.id) %>&list=<%= URI.encode_www_form(plid) %><%= "&index=#{(page - 1) * 100}&occurrence=#{first_video.index}" if playlist.is_a?(InvidiousPlaylist) %>"><%= Invidious::Frontend::Icons.render("play") %><%= I18n.translate(locale, page > 1 ? "overhaul_play" : "overhaul_play_all") %></a><% end %>
<% if owned %><a class="button" href="/add_playlist_items?list=<%= URI.encode_www_form(plid) %>"><%= Invidious::Frontend::Icons.render("plus") %><%= I18n.translate(locale, "playlist_button_add_items") %></a><a class="button" href="/edit_playlist?list=<%= URI.encode_www_form(plid) %>"><%= Invidious::Frontend::Icons.render("settings") %><%= I18n.translate(locale, "generic_button_edit") %></a><% else %><% reference_id = plid; reference_seed = nil.as(String?) %><%= rendered "overhaul/playlist_reference_actions" %><% end %>
<details class="ui-menu" data-ui-menu><summary class="button"><%= Invidious::Frontend::Icons.render("ellipsis-vertical") %><%= I18n.translate(locale, "overhaul_more") %></summary><div class="menu-content"><a href="/feed/playlist/<%= URI.encode_www_form(plid) %>"><%= Invidious::Frontend::Icons.render("rss") %><%= I18n.translate(locale, "generic_button_rss") %></a>
<% if owned %><a href="/delete_playlist?list=<%= URI.encode_www_form(plid) %>"><%= Invidious::Frontend::Icons.render("trash-2") %><%= I18n.translate(locale, "Delete playlist") %></a><% elsif !playlist.is_a?(InvidiousPlaylist) %><a href="https://www.youtube.com/playlist?list=<%= URI.encode_www_form(plid) %>" rel="noreferrer noopener"><%= Invidious::Frontend::Icons.render("external-link") %><%= I18n.translate(locale, "View playlist on YouTube") %></a><a href="<%= HTML.escape(env.get("preferences").as(Preferences).automatic_instance_redirect ? "/redirect?referer=#{URI.encode_www_form(env.request.resource)}" : "https://redirect.invidious.io/playlist?list=#{URI.encode_www_form(plid)}") %>"><%= Invidious::Frontend::Icons.render("external-link") %><%= I18n.translate(locale, "Switch Invidious Instance") %></a><% end %></div></details></div>
<% unless playlist.description_html.empty? %><details class="playlist-description"><summary><%= I18n.translate(locale, "ui_description") %></summary><div id="descriptionWrapper" dir="auto"><%= playlist.description_html %></div></details><% end %>
<% if owned %><p class="muted order-help"><%= I18n.translate(locale, "overhaul_reorder_help") %></p><p class="muted order-help-phone" hidden><%= I18n.translate(locale, "overhaul_reorder_help_phone") %></p><p role="status" data-order-status class="sr-only"></p><% end %>
<section <%= %(data-collection data-collection-kind="playlist") if user %> <%= %(data-playlist-id="#{HTML.escape(plid)}" data-order-offset="#{(page - 1) * 100}") if owned %>>
<% if user %><% collection_kind = "playlist" %><%= rendered "overhaul/collection_toolbar" %><% end %>
<%= rendered "components/items_paginated" %></section>

<%
    search_privacy = preferences.search_privacy
    search_query = query.text.size > 30 ? HTML.escape(query.text[0,30].rstrip(".")) + "&hellip;" : HTML.escape(query.text)
%>

<% content_for "header" do %>
<title><%= search_privacy ? "Search" : search_query %> - Invidious</title>
<link rel="stylesheet" href="/css/search.css?v=<%= ASSET_COMMIT %>">
<% end %>

<!-- Search redirection and filtering UI -->
<%= Invidious::Frontend::SearchFilters.generate(query.filters, query.text, query.page, locale) %>
<div class="active-filters">
<% query.filters.to_iv_params.each do |key, value| %>
    <% value.split(",").each do |option| %>
        <%
            remaining = query.to_http_params
            if key == "features" && value.split(",").size > 1
                remaining[key] = value.split(",").reject { |feature| feature == option }.join(",")
            else
                remaining.delete(key)
            end
        %>
        <a href="/search?<%= HTML.escape(remaining.to_s) %>" aria-label="<%= I18n.translate(locale, "ui_remove_filter") %>: <%= HTML.escape(I18n.translate(locale, "search_filters_#{key}_option_#{option}")) %>"><%= I18n.translate(locale, "search_filters_#{key}_option_#{option}") %> <span aria-hidden="true">×</span></a>
    <% end %>
<% end %>
</div>


<%- if items.empty? -%>
<div class="h-box no-results-error">
    <div>
        <%= I18n.translate(locale, "search_message_no_results") %><br/><br/>
        <%= I18n.translate(locale, "search_message_change_filters_or_query") %><br/><br/>
        <%= I18n.translate(locale, "search_message_use_another_instance", redirect_url) %>
    </div>
</div>
<%- else -%>
    <%= rendered "components/items_paginated" %>
<%- end -%>

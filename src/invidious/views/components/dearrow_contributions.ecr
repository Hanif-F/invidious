<% dearrow_ready = Invidious::DeArrow::IdentityCipher.ready?(CONFIG.dearrow_identity_key) %>
<% unless env.get?("dearrow_hide_entry") == true %>
<div class="dearrow-entry js-only">
    <% if user && dearrow_ready %>
    <button type="button" id="dearrow-open" class="button" aria-haspopup="dialog"><%= I18n.translate(locale, "dearrow_contribute") %></button>
    <% else %>
    <span tabindex="0" title="<%= I18n.translate(locale, user ? "dearrow_setup" : "dearrow_login") %>"><button type="button" class="button" disabled><%= I18n.translate(locale, "dearrow_contribute") %></button></span>
    <small><%= I18n.translate(locale, user ? "dearrow_setup" : "dearrow_login") %> <% unless user %><a href="/login?referer=<%= URI.encode_www_form("/watch?v=#{video.id}") %>"><%= I18n.translate(locale, "Sign In") %></a><% end %></small>
    <% end %>
</div>
<% end %>
<% if user && dearrow_ready %>
<dialog id="dearrow-dialog" aria-labelledby="dearrow-heading" data-video-id="<%= HTML.escape(video.id) %>">
    <header class="dearrow-header"><h2 id="dearrow-heading"><%= I18n.translate(locale, "dearrow_contribute") %></h2><button type="button" id="dearrow-close" class="icon-button" aria-label="<%= I18n.translate(locale, "dearrow_close") %>" title="<%= I18n.translate(locale, "dearrow_close") %>" autofocus><%= Invidious::Frontend::Icons.render("x") %></button></header>
    <div class="dearrow-content">
    <p id="dearrow-status" tabindex="-1" role="status" aria-live="polite"></p>
    <p id="dearrow-uncertain" class="dearrow-warning" hidden><%= I18n.translate(locale, "overhaul_dearrow_uncertain") %></p>
    <div class="toolbar" id="dearrow-mask-actions" hidden><button type="button" class="button" id="dearrow-mask-toggle" aria-pressed="false"><%= Invidious::Frontend::Icons.render("eye") %><span><%= I18n.translate(locale, "overhaul_dearrow_reveal") %></span></button><span id="dearrow-mask-state" role="status" hidden></span><button type="button" class="button" id="dearrow-mask-retry" hidden><%= Invidious::Frontend::Icons.render("rotate-cw") %><%= I18n.translate(locale, "ux_retry") %></button></div>
    <section id="dearrow-editor">
        <h3><%= I18n.translate(locale, "dearrow_original") %></h3>
        <% contribution_date = Invidious::ChannelSpoilers.video_publication(video.info) %>
        <% contribution_masked = Invidious::Frontend::ChannelSpoilers.hidden?(env, video.ucid, contribution_date, :title) %>
        <div id="dearrow-original" class="dearrow-row"><div class="dearrow-row-text"><span dir="auto" id="dearrow-original-title" data-original-title="<%= HTML.escape(Invidious::OriginalTitles.title(env, video.id, video.title)) %>"><%= contribution_masked ? HTML.escape(Invidious::Frontend::ChannelSpoilers.label(env, :title, contribution_date.nil?)) : HTML.escape(Invidious::OriginalTitles.title(env, video.id, video.title)) %></span><small data-dearrow-score></small><small data-dearrow-reason></small></div><div class="dearrow-votes"></div></div>
        <form id="dearrow-draft-form">
            <label for="dearrow-draft"><%= I18n.translate(locale, "dearrow_custom") %></label>
            <input id="dearrow-draft" type="text" maxlength="440" required placeholder="<%= I18n.translate(locale, "dearrow_input") %>" autocomplete="off">
            <button type="submit" class="button button-primary"><%= I18n.translate(locale, "dearrow_review") %></button>
        </form>
        <h3><%= I18n.translate(locale, "dearrow_titles") %></h3>
        <div id="dearrow-titles"></div>
        <button type="button" id="dearrow-refresh" class="button"><%= I18n.translate(locale, "dearrow_refresh") %></button>
    </section>
    <form id="dearrow-confirm" hidden>
        <p id="dearrow-preview" dir="auto"></p>
        <label class="dearrow-ack"><input type="checkbox" required><span><%= I18n.translate(locale, "dearrow_ack1") %><small><%= I18n.translate(locale, "dearrow_ack1_detail") %></small></span></label>
        <label class="dearrow-ack"><input type="checkbox" required><span><%= I18n.translate(locale, "dearrow_ack2") %><small><%= I18n.translate(locale, "dearrow_ack2_detail") %></small></span></label>
        <label class="dearrow-ack"><input type="checkbox" required><span><%= I18n.translate(locale, "dearrow_ack3") %><small><%= I18n.translate(locale, "dearrow_ack3_detail") %></small></span></label>
        <label class="dearrow-ack"><input type="checkbox" required><span><%= I18n.translate(locale, "dearrow_ack4") %><small><%= I18n.translate(locale, "dearrow_ack4_detail") %></small></span></label>
        <p><%= I18n.translate(locale, "dearrow_check_all") %></p>
        <div class="dearrow-confirm-actions"><button type="submit" id="dearrow-send" class="button button-primary" disabled><%= I18n.translate(locale, "dearrow_submit") %></button><button type="button" id="dearrow-edit" class="button"><%= I18n.translate(locale, "dearrow_cancel") %></button></div>
    </form>
    <p><a href="https://wiki.sponsor.ajay.app/w/DeArrow/Guidelines" target="_blank" rel="noopener noreferrer"><%= I18n.translate(locale, "dearrow_guidelines") %></a></p>
    <small><%= I18n.translate(locale, "dearrow_privacy") %></small>
    <p><a class="button" href="/preferences/dearrow/identity"><%= Invidious::Frontend::Icons.render("lock") %><%= I18n.translate(locale, "overhaul_identity_heading") %></a></p>
    </div>
</dialog>
<template id="dearrow-vote-template"><button class="button" type="button"><%= Invidious::Frontend::Icons.render("thumbs-up") %><span></span></button></template>
<script id="dearrow-contribution-config" type="application/json"><%= {
    "script" => "/js/dearrow-contributions.js?v=#{ASSET_COMMIT}",
    "style" => "/css/dearrow-contributions.css?v=#{ASSET_COMMIT}",
    "csrf" => env.get?("csrf_token").try(&.as(String)) || "",
    "profile" => Invidious::BrowserProfiles.render_scope(env),
    "channel" => video.ucid,
    "published" => contribution_date.try(&.to_unix),
    "masked" => contribution_masked,
    "hidden_title" => Invidious::Frontend::ChannelSpoilers.label(env, :title, contribution_date.nil?),
    "upvote" => I18n.translate(locale, "dearrow_upvote"),
    "downvote" => I18n.translate(locale, "dearrow_downvote"),
    "locked" => I18n.translate(locale, "dearrow_locked"),
    "no_original" => I18n.translate(locale, "dearrow_no_original"),
    "loading" => I18n.translate(locale, "dearrow_loading"),
    "empty" => I18n.translate(locale, "dearrow_empty"),
    "sending" => I18n.translate(locale, "dearrow_sending"),
    "success" => I18n.translate(locale, "dearrow_success"),
    "error" => I18n.translate(locale, "dearrow_error"),
    "partial" => I18n.translate(locale, "dearrow_partial"),
    "uncertain" => I18n.translate(locale, "overhaul_dearrow_unknown_status"),
    "invalid" => I18n.translate(locale, "overhaul_dearrow_invalid"),
    "reveal" => I18n.translate(locale, "overhaul_dearrow_reveal"),
    "hide" => I18n.translate(locale, "overhaul_dearrow_hide"),
    "score" => I18n.translate(locale, "overhaul_dearrow_score"),
    "proposal" => I18n.translate(locale, "overhaul_dearrow_proposal"),
    "original" => I18n.translate(locale, "dearrow_original"),
    "profile_changed" => I18n.translate(locale, "overhaul_channel_profile_changed"),
    "rejected" => I18n.translate(locale, "overhaul_dearrow_rejected"),
}.to_json.gsub("<", "\\u003c") %></script>
<script src="/js/dearrow-loader.js?v=<%= ASSET_COMMIT %>" defer></script>
<% end %>

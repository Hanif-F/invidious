<% sb_enabled, sb_modes = Invidious::SponsorBlock.effective(preferences.sponsorblock_enabled, preferences.sponsorblock_modes, env.get?("user") ? preferences.sponsorblock_channel_overrides[video.ucid]? : nil) %>
<%
    invidious_companion_check_id = invidious_companion_encrypt(video.id) if invidious_companion
%>
<% player_spoiler_date = Invidious::ChannelSpoilers.video_publication(video.info) %>
<% player_title_hidden = Invidious::Frontend::ChannelSpoilers.hidden?(env, video.ucid, player_spoiler_date, :title) %>
<% player_thumbnail_hidden = Invidious::Frontend::ChannelSpoilers.hidden?(env, video.ucid, player_spoiler_date, :thumbnail) %>
<video data-spoiler-channel="<%= video.ucid %>" data-spoiler-published="<%= player_spoiler_date.try(&.to_unix) %>" data-spoiler-poster="<%= thumbnail %>" style="width:100%;background-color:#000" playsinline poster="<%= player_thumbnail_hidden ? "" : thumbnail %>"
    id="player" class="on-video_player video-js player-style-<%= params.player_style %>"
    preload="<% if params.preload %>auto<% else %>none<% end %>"
    <% if params.autoplay %>autoplay<% end %>
    <% if params.video_loop %>loop<% end %>
    <% if params.controls %>controls<% end %>>
    <% if (hlsvp = video.hls_manifest_url) && video.live_now && !CONFIG.disabled?("livestreams") %>
        <source src="<%= URI.parse(hlsvp).request_target %><% if params.local %>?local=true<% end %>" type="application/x-mpegURL" label="livestream">
    <% else %>
        <% if params.listen %>
            <% listening_streams = Invidious::Videos::AudioPreferences.select(audio_streams, params.preferred_audio)
               best_audio = Invidious::Videos::AudioPreferences.best(listening_streams)
               best_audio_index = listening_streams.index(best_audio) || 0
               listening_streams.each_with_index do |fmt, i|
                source_params = URI::Params.new
                source_params["id"] = video.id
                source_params["itag"] = fmt["itag"].to_s
                source_params["audio_track"] = Invidious::Videos::AudioPreferences.identity(fmt)
                source_params["is_drc"] = Invidious::Videos::AudioMetadata.stable_volume?(fmt).to_s
                source_params["local"] = "true" if params.local
                source_params["region"] = params.region.not_nil! if params.region
                src_url = "/latest_version?#{source_params}"

                bitrate = fmt["bitrate"]
                mimetype = HTML.escape(fmt["mimeType"].as_s)

                selected = (i == best_audio_index)
            %>
                <source src="<%= src_url %><%= "#t=#{params.video_start},#{params.video_end}" if params.video_end > 0 && (env.get?("native_clip_id") || env.params.query["clip_preview"]? == "1") %>" type='<%= mimetype %>' label="<%= bitrate %>k" selected="<%= selected %>">
                <% if !params.local && !CONFIG.disabled?("local") %>
                <source src="<%= src_url %>&local=true<%= "#t=#{params.video_start},#{params.video_end}" if params.video_end > 0 && (env.get?("native_clip_id") || env.params.query["clip_preview"]? == "1") %>" type='<%= mimetype %>' hidequalityoption="true">
                <% end %>
            <% end %>
        <% else %>
            <% if params.quality == "dash"
               src_url = "/api/manifest/dash/id/" + video.id + "?local=true"
               src_url = invidious_companion.public_url.to_s + src_url +
                            "&check=#{invidious_companion_check_id}" if (invidious_companion)
            %>
                <source src="<%= src_url %><%= "#t=#{params.video_start},#{params.video_end}" if params.video_end > 0 && (env.get?("native_clip_id") || env.params.query["clip_preview"]? == "1") %>" type='application/dash+xml' label="dash">
            <% end %>

            <%
            fmt_stream.reject! { |f| f["itag"] == 17 }
            fmt_stream.sort_by! {|f| params.quality == f["quality"] ? 0 : 1 }
            fmt_stream.each_with_index do |fmt, i|
                src_url  = "/latest_version?id=#{video.id}&itag=#{fmt["itag"]}"
                src_url += "&local=true" if params.local
                src_url = invidious_companion.public_url.to_s + src_url +
                            "&check=#{invidious_companion_check_id}" if (invidious_companion)

                quality = fmt["quality"]
                mimetype = HTML.escape(fmt["mimeType"].as_s)

                selected = params.quality ? (params.quality == quality) : (i == 0)
            %>
                <source src="<%= src_url %><%= "#t=#{params.video_start},#{params.video_end}" if params.video_end > 0 && (env.get?("native_clip_id") || env.params.query["clip_preview"]? == "1") %>" type="<%= mimetype %>" label="<%= quality %>" selected="<%= selected %>">
                <% if !params.local && !CONFIG.disabled?("local") %>
                <source src="<%= src_url %>&local=true<%= "#t=#{params.video_start},#{params.video_end}" if params.video_end > 0 && (env.get?("native_clip_id") || env.params.query["clip_preview"]? == "1") %>" type="<%= mimetype %>" hidequalityoption="true">
                <% end %>
            <% end %>
        <% end %>

        <% preferred_captions.each do |caption|
            api_captions_url = "/api/v1/captions/"
            api_captions_url = invidious_companion.public_url.to_s + api_captions_url if (invidious_companion)
            api_captions_check_id = "&check=#{invidious_companion_check_id}"
        %>
            <track kind="captions" src="<%= api_captions_url %><%= video.id %>?label=<%= caption.name %><%= api_captions_check_id %>" label="<%= caption.name %>">
        <% end %>

        <% captions.each do |caption|
            api_captions_url = "/api/v1/captions/"
            api_captions_url = invidious_companion.public_url.to_s + api_captions_url if (invidious_companion)
            api_captions_check_id = "&check=#{invidious_companion_check_id}"
        %>
            <track kind="captions" src="<%= api_captions_url %><%= video.id %>?label=<%= caption.name %><%= api_captions_check_id %>" label="<%= caption.name %>">
        <% end %>
    <% end %>
</video>

<script id="player_data" type="application/json">
<%=
{
    "sponsorblock" => {
        "enabled" => sb_enabled && !video.live_now,
        "modes" => sb_modes,
        "colors" => preferences.sponsorblock_colors,
        "labels" => Invidious::SponsorBlock::CATEGORIES.to_h { |category, _| {category, I18n.translate(locale, "sb_category_#{category}")} },
        "skip" => I18n.translate(locale, "sb_skip"),
        "skipped" => I18n.translate(locale, "sb_skipped"),
        "dismiss" => I18n.translate(locale, "sb_dismiss"),
    },
    "mobile_labels" => %w(settings quality audio captions speed share back close off appearance).to_h { |key| {key, I18n.translate(locale, "mobile_player_#{key}")} },
    "stream_labels" => %w(auto unknown_codec high_bitrate medium_bitrate low_bitrate stable_volume original_audio dubbed_audio).to_h { |key| {key, I18n.translate(locale, "player_stream_#{key}")} },
    "refresh_buffer" => I18n.translate(locale, "player_refresh_buffer"),
    "stats_labels" => %w(identity title close details copy disable unavailable waiting resolution viewport quality codecs fps bitrate frames buffer bandwidth bytes requests state stalls live help copied fallback).to_h { |key| {key, I18n.translate(locale, "stats_#{key}")} },
    "stats_formats" => (fmt_stream + adaptive_fmts).map { |fmt| fmt.select { |key, _| %w(itag mimeType width height fps bitrate contentLength audioQuality audioTrack).includes?(key) }.merge({"isDrc" => JSON::Any.new(Invidious::Videos::AudioMetadata.stable_volume?(fmt))}) },
    "chapters" => Invidious::Videos::Chapters.parse(video.short_description, video.live_now ? 0 : video.length_seconds),
    "aspect_ratio" => aspect_ratio,
    "seek_seconds" => preferences.seek_seconds,
    "title" => player_title_hidden ? Invidious::Frontend::ChannelSpoilers.label(env, :title, player_spoiler_date.nil?) : (env.get?("native_clip_title").try(&.as(String)) || video.title),
    "spoiler_overlay" => Invidious::Frontend::ChannelSpoilers.title(env, video.id, video.ucid, env.get?("native_clip_title").try(&.as(String)) || video.title, player_spoiler_date, true),
    "clip_unavailable" => I18n.translate(locale, "clips_unavailable"),
    "description" => HTML.escape(video.short_description),
    "thumbnail" => player_thumbnail_hidden ? "" : thumbnail,
    "preferred_caption_found" => !preferred_captions.empty?
}.to_pretty_json.gsub("<", "\\u003c")
%>
</script>
<script src="/js/player-stream-menu.js?v=<%= ASSET_COMMIT %>"></script>
<script src="/js/clip-player.js?v=<%= ASSET_COMMIT %>"></script>
<script src="/js/player.js?v=<%= ASSET_COMMIT %>"></script>

<script src="/js/player-chapters.js?v=<%= ASSET_COMMIT %>"></script>
<script src="/js/sponsorblock.js?v=<%= ASSET_COMMIT %>"></script>

<script src="/js/player-stats.js?v=<%= ASSET_COMMIT %>"></script>
<script src="/js/player-mobile.js?v=<%= ASSET_COMMIT %>"></script>

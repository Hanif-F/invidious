<% content_for "header" do %><title><%= I18n.translate(locale, "Post") %> - Invidious</title><% end %>
<header class="page-heading"><h1><%= I18n.translate(locale, "Post") %></h1><% if ucid %><a href="/channel/<%= HTML.escape(ucid) %>/community"><%= Invidious::Frontend::Icons.render("arrow-left") %><%= I18n.translate(locale, "channel_tab_posts_label") %></a><% end %></header>
<div id="post" class="comment-list"><%= IV::Frontend::Comments.template_youtube(post_response.not_nil!, locale, env.get("preferences").as(Preferences).thin_mode) %></div>
<section class="comment-list" aria-labelledby="comments-heading"><h2 id="comments-heading"><%= I18n.translate(locale, "Comments") %></h2><div id="comments"><% if nojs %><%= comment_html %><% else %><noscript><a class="button" href="/post/<%= URI.encode_www_form(id) %>?ucid=<%= URI.encode_www_form(ucid.to_s) %>&nojs=1"><%= I18n.translate(locale, "Hi! Looks like you have JavaScript turned off. Click here to view comments, keep in mind they may take a bit longer to load.") %></a></noscript><% end %></div></section>
<% comment_initial = !nojs; comment_base_url = "/api/v1/post/#{URI.encode_www_form(id)}/comments"; comment_ucid = ucid.to_s %><%= rendered "overhaul/comment_config" %>

<% content_for "header" do %><title><%= I18n.translate(locale, "admin_instance_settings") %> - Invidious</title><% end %>
<% if Invidious::Frontend::Desktop.api_only? %>
<%= rendered "admin/settings_form" %>
<% else %>
<% section = "admin" %>
<header class="page-heading"><h1><%= I18n.translate(locale, "overhaul_settings") %></h1></header>
<div class="settings-layout"><%= rendered "overhaul/settings_navigation" %>
<section class="settings-category"><%= rendered "admin/settings_form" %></section>
</div>
<% end %>

<% preferences = env.get?("preferences").try(&.as(Preferences)) || Preferences.from_json("{}"); locale = preferences.locale %>
<!DOCTYPE html><html lang="<%= HTML.escape(locale) %>" dir="<%= I18n.locale_is_rtl?(locale) ? "rtl" : "ltr" %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><%= yield_content "header" %><link rel="stylesheet" href="/css/foundation.css?v=<%= ASSET_COMMIT %>"></head><body class="<%= preferences.dark_mode == "dark" ? "dark-theme" : preferences.dark_mode == "light" ? "light-theme" : "no-theme" %>"><main class="standalone-content" id="main-content"><a href="/admin/settings">Invidious</a><%= content %></main><% if env.get?("standalone_account") || env.get?("account_surface") %><script src="/js/account-forms.js?v=<%= ASSET_COMMIT %>" defer></script><% end %></body></html>

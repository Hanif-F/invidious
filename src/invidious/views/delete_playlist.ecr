<% unsave = subscribed || !plid.starts_with?("IV"); action_label = I18n.translate(locale, unsave ? "overhaul_unsave_playlist" : "Delete playlist") %>
<% content_for "header" do %><title><%= action_label %> - Invidious</title><% end %>
<section class="reading-page"><header class="page-heading"><h1><%= action_label %></h1><p dir="auto"><%= HTML.escape(playlist.title) %></p></header>
<p><%= I18n.translate(locale, unsave ? "overhaul_unsave_consequence" : "overhaul_delete_playlist_consequence") %></p>
<form action="/delete_playlist?list=<%= URI.encode_www_form(plid) %>" method="post" class="toolbar"><input type="hidden" name="operation" value="<%= unsave ? "unsave" : "delete" %>"><input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>">
<a class="button" href="/feed/playlists" autofocus><%= I18n.translate(locale, "generic_button_cancel") %></a><button type="submit" class="button button-danger"><%= Invidious::Frontend::Icons.render("trash-2") %><%= action_label %></button></form></section>

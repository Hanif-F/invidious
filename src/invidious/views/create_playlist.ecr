<% content_for "header" do %><title><%= I18n.translate(locale, "Create playlist") %> - Invidious</title><% end %>
<section class="reading-page playlist-form-page"><header class="page-heading"><h1><%= I18n.translate(locale, "Create playlist") %></h1></header>
<form action="/create_playlist?referer=<%= URI.encode_www_form(referer) %>" method="post" data-playlist-form="create" class="stacked-form">
<% form_title = env.params.body["title"]? || ""; form_privacy = env.params.body["privacy"]? || "Public"; form_description = ""; is_edit = false %>
<%= rendered "overhaul/playlist_fields" %>
<div class="toolbar"><button type="submit" class="button button-primary" <%= "disabled" if env.get?("playlist_form_uncertain") == true %>><%= Invidious::Frontend::Icons.render("plus") %><%= I18n.translate(locale, "Create playlist") %></button><a class="button" href="<%= HTML.escape(referer) %>"><%= I18n.translate(locale, "generic_button_cancel") %></a></div>
<input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>">
</form></section>

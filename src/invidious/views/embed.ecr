<% spoiler_date = Invidious::ChannelSpoilers.video_publication(video.info) %>
<% original_title = Invidious::OriginalTitles.title(env, video.id, video.title) %>
<% env.set "spoiler_page", {"channel" => video.ucid, "published" => spoiler_date.try(&.to_unix), "title" => original_title, "thumbnail" => thumbnail}.to_json %>
<% display_thumbnail = Invidious::Frontend::ChannelSpoilers.hidden?(env, video.ucid, spoiler_date, :thumbnail) ? "" : thumbnail %>
<% display_title = Invidious::Frontend::ChannelSpoilers.hidden?(env, video.ucid, spoiler_date, :title) ? Invidious::Frontend::ChannelSpoilers.label(env, :title, spoiler_date.nil?) : original_title %>
<!DOCTYPE html>
<html class="embed-document" lang="<%= HTML.escape(preferences.locale) %>" dir="<%= I18n.locale_is_rtl?(preferences.locale) ? "rtl" : "ltr" %>">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="thumbnail" content="<%= HTML.escape(display_thumbnail) %>">
    <link rel="stylesheet" href="/css/foundation.css?v=<%= ASSET_COMMIT %>">
    <script id="browser-profile" type="application/json"><%= {scope: Invidious::BrowserProfiles.render_scope(env), cookieDomain: Invidious::Authentication.cookie_domain(env), saveError: I18n.translate(preferences.locale, "browser_save_error")}.to_json.gsub("<", "\\u003c") %></script>
    <script src="/js/browser-storage.js?v=<%= ASSET_COMMIT %>"></script>
    <script src="/js/_helpers.js?v=<%= ASSET_COMMIT %>"></script>
    <% if (expiry = env.get?("verification_expiry")) || CONFIG.login_required %>
    <script id="verification-access" type="application/json" data-login-required="<%= CONFIG.login_required %>" data-login-heading="<%= HTML.escape(I18n.translate(preferences.locale, "embed_login_heading")) %>" data-login-message="<%= HTML.escape(I18n.translate(preferences.locale, "embed_login_message")) %>" data-login-action="<%= HTML.escape(I18n.translate(preferences.locale, "embed_login_action")) %>" data-required-label="<%= HTML.escape(I18n.translate(preferences.locale, "Verification required")) %>" data-playback-label="<%= HTML.escape(I18n.translate(preferences.locale, "Verification is required to play this video.")) %>" data-open-label="<%= HTML.escape(I18n.translate(preferences.locale, "Open this instance to verify and watch")) %>"><%= expiry ? expiry.as(String).to_i64 : 0 %></script>
    <script src="/js/bot-protection.js?v=<%= ASSET_COMMIT %>"></script>
    <% end %>
    <script id="ui-config" type="application/json"><%= {"csrf" => env.get?("csrf_token").try(&.as(String)) || "", "signedIn" => !!env.get?("user"), "words" => %w(error read_error retry loading page_only saved).to_h { |key| {key, I18n.translate(locale, "ux_#{key}")} }}.to_json.gsub("<", "\\u003c") %></script>
    <script src="/js/ui.js?v=<%= ASSET_COMMIT %>"></script>
    <%= rendered "components/channel_spoiler_scripts" %>
    <%= rendered "components/player_sources" %>
    <link rel="stylesheet" href="/videojs/videojs-overlay/videojs-overlay.css?v=<%= ASSET_COMMIT %>">
    <script src="/videojs/videojs-overlay/videojs-overlay.js?v=<%= ASSET_COMMIT %>"></script>
    <link rel="stylesheet" href="/css/embed.css?v=<%= ASSET_COMMIT %>">
    <title><%= HTML.escape(display_title) %> - Invidious</title>

</head>

<body class="embed-page <%= Invidious::Frontend::Desktop.color_mode(preferences).empty? ? "no" : Invidious::Frontend::Desktop.color_mode(preferences) %>-theme" data-overhaul data-page="embed">
<script id="video_data" type="application/json">
<%=
{
    "id" => video.id,
    "channel_id" => video.ucid,
    "live_now" => video.live_now,
    "clip" => preview_clip ? {"url" => nil, "startTime" => params.video_start, "endTime" => params.video_end} : nil,
    "index" => continuation,
    "plid" => plid,
    "length_seconds" => video.length_seconds.to_f,
    "skip_playback_position" => video.music_genre?,
    "record_completion" => !!user.try(&.preferences.watch_history),
    "playback_sync" => playback_sync,
    "playback_position" => playback_position,
    "csrf_token" => env.get?("csrf_token").try(&.as(String)) || "",
    "video_series" => video_series,
    "params" => params,
    "preferences" => preferences,
    "premiere_timestamp" => video.premiere_timestamp.try &.to_unix,
    "local_disabled" => CONFIG.disabled?("local")
}.to_pretty_json.gsub("<", "\\u003c")
%>
</script>
<script id="config" type="application/json">
<%=
{
    "videojs" => CONFIG.videojs,
}.to_pretty_json.gsub("<", "\\u003c")
%>
</script>

<main id="main-content" class="embed-player" aria-label="<%= I18n.translate(locale, "embed_player_label") %>">
<%= rendered "components/player" %>
<aside id="embed-status" class="embed-status" role="status" hidden></aside>
<aside id="ui-notice" class="embed-status" hidden><span role="status"></span></aside>
<aside id="browser-profile-recovery" class="embed-status" hidden>
    <span role="status"><%= I18n.translate(preferences.locale, "browser_profile_refresh") %></span>
    <button type="button" class="button"><%= I18n.translate(preferences.locale, "overhaul_refresh") %></button>
</aside>
</main>
<script id="dearrow-config" type="application/json"><%= {"enabled" => preferences.dearrow_enabled, "showOriginal" => preferences.dearrow_show_original, "originalLabel" => I18n.translate(locale, "dearrow_reveal_original"), "replacementLabel" => I18n.translate(locale, "spoilers_next_dearrow")}.to_json.gsub("<", "\\u003c") %></script>
<script src="/js/dearrow.js?v=<%= ASSET_COMMIT %>" defer></script>
<script id="embed-config" type="application/json"><%= %w(queue_failed queue_retry).to_h { |key| {key, I18n.translate(locale, "embed_#{key}")} }.to_json.gsub("<", "\\u003c") %></script>
<script src="/js/embed.js?v=<%= ASSET_COMMIT %>" defer></script>
</body>
</html>

<% env.set "search_homepage", true %>
<% content_for "header" do %><meta name="description" content="<%= I18n.translate(locale, "An alternative front-end to YouTube") %>"><title>Invidious - <%= I18n.translate(locale, "search") %></title><% end %>
<section class="search-home" aria-labelledby="search-home-title"><img src="/invidious-colored-vector.svg" alt="" width="72" height="72"><h1 id="search-home-title">Invidious</h1><p class="muted"><%= I18n.translate(locale, "overhaul_search_home_hint") %></p>
<form action="/search" method="<%= Invidious::Frontend::Desktop.private_search?(env) ? "post" : "get" %>" role="search" class="search-home-form"><label class="sr-only" for="searchbox"><%= I18n.translate(locale, "search") %></label><input type="search" id="searchbox" name="q" autocomplete="off" autocapitalize="none" spellcheck="false" autofocus><button class="button button-primary" aria-label="<%= I18n.translate(locale, "search") %>"><%= Invidious::Frontend::Icons.render("search") %><%= I18n.translate(locale, "search") %></button></form></section>

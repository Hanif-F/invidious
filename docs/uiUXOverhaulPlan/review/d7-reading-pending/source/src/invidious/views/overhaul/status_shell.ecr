<% status_preferences = env.get("preferences").as(Preferences); locale = status_preferences.locale %>
<!doctype html><html lang="<%= HTML.escape(locale) %>" dir="<%= I18n.locale_is_rtl?(locale) ? "rtl" : "ltr" %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><%= yield_content "header" %><link rel="stylesheet" href="/css/foundation.css?v=<%= ASSET_COMMIT %>"></head><body class="<%= Invidious::Frontend::Desktop.color_mode(status_preferences).empty? ? "no" : Invidious::Frontend::Desktop.color_mode(status_preferences) %>-theme"><main class="standalone-content" id="main-content"><span class="brand">Invidious</span><%= content %></main></body></html>

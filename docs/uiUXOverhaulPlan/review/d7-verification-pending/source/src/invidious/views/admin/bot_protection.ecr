<% verification_preferences = env.get?("preferences").try(&.as(Preferences)) || Preferences.from_json("{}"); locale = verification_preferences.locale %>
<!doctype html>
<html lang="<%= HTML.escape(locale) %>" dir="<%= I18n.locale_is_rtl?(locale) ? "rtl" : "ltr" %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= I18n.translate(locale, "verify_settings") %> - Invidious</title><link rel="stylesheet" href="/css/foundation.css?v=<%= ASSET_COMMIT %>"><link rel="stylesheet" href="/css/verification.css?v=<%= ASSET_COMMIT %>"></head>
<body class="<%= verification_preferences.dark_mode == "dark" ? "dark" : verification_preferences.dark_mode == "light" ? "light" : "no" %>-theme"><main class="verification-panel" id="main-content">
<header><a class="brand" href="/admin/settings">Invidious</a><h1 dir="auto"><%= I18n.translate(locale, "verify_settings") %></h1></header>
<% if message %><p dir="auto" class="form-feedback" role="<%= env.response.status_code >= 400 ? "alert" : "status" %>"><%= HTML.escape(I18n.translate(locale, message)) %></p><% end %>
<section aria-labelledby="verification-readiness"><h2 id="verification-readiness"><%= I18n.translate(locale, "verify_configuration") %></h2><p dir="auto"><strong><%= I18n.translate(locale, problems.empty? ? "verify_ready" : "verify_not_ready") %></strong></p>
<% unless problems.empty? %><ul><% problems.each do |problem| %><li><%= HTML.escape(problem) %></li><% end %></ul><% end %></section>
<form class="stacked-form" action="/admin/bot-protection" method="post" data-account-form>
<input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>">
<label class="verification-toggle"><input type="checkbox" name="enabled" <%= form_enabled ? "checked" : "" %>><span><%= I18n.translate(locale, "verify_require") %></span></label>
<label for="duration_hours"><%= I18n.translate(locale, "verify_duration") %></label><select id="duration_hours" name="duration_hours"><% {1, 12, 24}.each do |hours| %><option value="<%= hours %>" <%= form_duration == hours ? "selected" : "" %>><%= I18n.translate(locale, hours == 1 ? "verify_hour_option" : "verify_hours_option", hours.to_s) %></option><% end %></select>
<p dir="auto" class="muted"><%= I18n.translate(locale, "verify_policy_consequences") %></p>
<div class="toolbar"><button class="button button-primary" type="submit"><%= I18n.translate(locale, "verify_save") %></button></div>
</form><nav class="toolbar verification-links"><a class="button" href="/admin/settings"><%= I18n.translate(locale, "admin_instance_settings") %></a><form action="/signout?referer=%2Fadmin%2Fbot-protection" method="post" data-account-form><input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>"><button class="button" type="submit"><%= I18n.translate(locale, "Log out") %></button></form></nav>
</main><script src="/js/account-forms.js?v=<%= ASSET_COMMIT %>" defer></script></body></html>

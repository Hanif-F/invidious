<% content_for "header" do %><title><%= I18n.translate(locale, "Token") %> - Invidious</title><% end %>
<section class="reading-page account-page" aria-labelledby="token-heading">
<% if env.get? "access_token" %>
  <h1 id="token-heading"><%= I18n.translate(locale, "ux_token_created") %></h1>
  <p><%= I18n.translate(locale, "ux_token_keep_private") %></p>
  <pre class="issued-token" tabindex="0" aria-label="<%= I18n.translate(locale, "Token") %>"><code><%= HTML.escape(env.get("access_token").as(String)) %></code></pre>
  <nav class="toolbar"><a class="button" href="/token_manager"><%= I18n.translate(locale, "overhaul_sessions") %></a><a class="button" href="/account"><%= I18n.translate(locale, "Account settings") %></a></nav>
<% else %>
  <h1 id="token-heading"><%= I18n.translate(locale, "Authorize token?") %></h1>
  <p><%= I18n.translate(locale, "ux_token_consent") %></p>
  <section class="account-section" aria-labelledby="scopes-heading">
    <h2 id="scopes-heading"><%= I18n.translate(locale, "ux_token_scopes") %></h2>
    <% if scopes.empty? %><p class="muted"><%= I18n.translate(locale, "ux_token_scopes_empty") %></p><% else %><ul class="scope-list"><% scopes.each do |scope| %><li><code><%= HTML.escape(scope) %></code></li><% end %></ul><% end %>
    <p class="muted"><%= I18n.translate(locale, "ux_token_scope_help") %></p>
    <p><% if expire %><% if (-62135596800_i64..253402300799_i64).includes?(expire.to_i64) %><%= I18n.translate(locale, "ux_token_expires") %> <time datetime="<%= Time.unix(expire.to_i64).to_rfc3339 %>"><%= Time.unix(expire.to_i64).to_s("%Y-%m-%d %H:%M UTC") %></time><% else %><%= I18n.translate(locale, "ux_token_unix_expiry") %> <code><%= expire %></code><% end %><% else %><%= I18n.translate(locale, "ux_token_no_expiry") %><% end %></p>
  </section>
  <% if callback_url %><section class="account-section" aria-labelledby="callback-heading"><h2 id="callback-heading"><%= I18n.translate(locale, "ux_token_destination") %></h2><p><%= I18n.translate(locale, "ux_token_callback_help") %></p><p class="callback-address"><code><%= HTML.escape(callback_url.to_s) %></code></p></section><% end %>
  <form action="/authorize_token" method="post" data-account-form>
    <% scopes.each_with_index do |scope, i| %><input type="hidden" name="scopes[<%= i %>]" value="<%= HTML.escape(scope) %>"><% end %>
    <% if callback_url %><input type="hidden" name="callbackUrl" value="<%= HTML.escape(callback_url.to_s) %>"><% end %>
    <% if expire %><input type="hidden" name="expire" value="<%= expire %>"><% end %>
    <input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>">
    <div class="toolbar"><button type="submit" class="button button-primary"><%= I18n.translate(locale, "ux_token_authorize") %></button><a class="button" href="/token_manager"><%= I18n.translate(locale, "Cancel") %></a></div>
  </form>
<% end %>
</section>

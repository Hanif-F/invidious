        <header class="watch-heading">
            <% if native_clip %>
            <div data-dearrow-row><%= Invidious::Frontend::ChannelSpoilers.title(env, video.id, video.ucid, original_title, spoiler_date, true, false, "h1", custom: true) %></div>
            <p><%= I18n.translate(locale, "clips_by") %> <%= HTML.escape(native_clip.creator) %> · <%= native_clip.start_time %>–<%= native_clip.end_time %> s</p>
            <p dir="auto" data-dearrow-row><a href="/watch?v=<%= video.id %>"><%= Invidious::Frontend::ChannelSpoilers.title(env, video.id, video.ucid, video.title, spoiler_date) %></a></p>
            <p class="js-only"><label><input id="clip-loop" type="checkbox" <%= "checked" if params.video_loop %>> <%= I18n.translate(locale, "clips_loop") %></label></p>
            <p><a class="button" href="/watch?v=<%= video.id %>&t=<%= native_clip.start_time %>"><%= I18n.translate(locale, "clips_full_video") %></a>
            <% if user && user.email == native_clip.owner %><a href="/delete_clip?id=<%= native_clip.id %>"><%= I18n.translate(locale, "clips_delete") %></a><% end %></p>
            <% else %>
            <div data-dearrow-row><%= Invidious::Frontend::ChannelSpoilers.title(env, video.id, video.ucid, video.title, spoiler_date, true, true, "h1") %></div>

            <% end %>
    <% if !video.is_listed %>
        <h3>
            <%= Invidious::Frontend::Icons.render("globe") %> <%= I18n.translate(locale, "Unlisted") %>
        </h3>
    <% end %>

    <% if video.reason %>
        <h3>
            <%= HTML.escape(video.reason.to_s) %>
        </h3>
    <% elsif video.premiere_timestamp.try &.> Time.utc %>
        <h3>
            <%= video.premiere_timestamp.try { |t| I18n.translate(locale, "Premieres in `x`", recode_date((t - Time.utc).ago, locale)) } %>
        </h3>
    <% elsif video.live_now %>
        <h3>
            <%= video.premiere_timestamp.try { |t| I18n.translate(locale, "videoinfo_started_streaming_x_ago", recode_date((Time.utc - t).ago, locale)) } %>
        </h3>
    <% end %>
            <div class="video-stats">
                <% if count = Invidious::Frontend::ViewCounts.get(env, video.id) %><p id="views"><%= HTML.escape(count.text(locale)) %></p><% end %>
                <p id="likes"><%= Invidious::Frontend::Icons.render("thumbs-up") %> <%= number_with_separator(video.likes) %> <%= I18n.translate(locale, "ui_likes") %></p>
                <p id="published-date"><% if video.premiere_timestamp.try &.> Time.utc %>
                    <%= I18n.translate(locale, "Premieres `x`", video.premiere_timestamp.not_nil!.to_s("%B %-d, %R UTC")) %>
                <% else %>
                    <%= I18n.translate(locale, "Shared `x`", video.published.to_s("%B %-d, %Y")) %>
                <% end %></p>
            </div>
        </header>
